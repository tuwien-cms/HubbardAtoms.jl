      - 4 * u * a ^ (6 : ℕ) * w ^ (4 : ℕ) * β * P * ρ ^ (2 : ℕ) * M
      + 8 * u * a ^ (6 : ℕ) * w ^ (4 : ℕ) * β * P * ρ * M ^ (2 : ℕ)
      - 4 * u * a ^ (6 : ℕ) * w ^ (4 : ℕ) * β * P * M ^ (3 : ℕ)
      + 4 * u * a ^ (6 : ℕ) * w ^ (4 : ℕ) * β * ρ ^ (2 : ℕ) * M
      - 4 * u * a ^ (6 : ℕ) * w ^ (4 : ℕ) * β * ρ * M ^ (2 : ℕ)
    ) * hE

/-- At a root of `E₈`, the constant part of the residue of `Γ_L(-t, z; t, v) - Γ_L(t, v; -t, z)`. -/
theorem sym_c (u s a w β P ρ M : ℂ) (hE : E8W u a w P ρ M = 0) :
    8 * a * (4 * a ^ 2) * ρ * M * u ^ 2 * (u ^ 2 + a ^ 2 - w ^ 2 / 4) *
        KtW u s a w β P ρ M * KnSW u s a w β P ρ M -
      aAW u a w P ρ M * (FnpW u s a w β P ρ M - FnmW u s a w β P ρ M) * u *
        KnSW u s a w β P ρ M +
      anW u a w P ρ M * (GpSW u a w β P ρ M - GmSW u s a w β P ρ M) * u *
        KtW u s a w β P ρ M = 0 := by
  rw [KtW_split, KnSW_split, GmSW_split, FnpW_split, FnmW_split]
  linear_combination sym_c0 u a w β P ρ M hE + s * sym_c1 u a w β P ρ M hE +
    s ^ 2 * sym_c2 u a w β P ρ M hE

end LCert

end HubbardAtom
