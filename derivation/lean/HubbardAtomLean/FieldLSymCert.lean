/-- `a_{-t} = 2λ²D_{-t}(u² + q₀)`. -/
noncomputable def anW (u a w P ρ M : ℂ) : ℂ :=
    -16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * P * ρ - 16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * P * M
    + 16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * ρ - 16 * a ^ (6 : ℕ) * P * ρ - 16 * a ^ (6 : ℕ) * P * M
    + 16 * a ^ (6 : ℕ) * ρ + 4 * a ^ (4 : ℕ) * w ^ (2 : ℕ) * P * ρ
    + 4 * a ^ (4 : ℕ) * w ^ (2 : ℕ) * P * M - 4 * a ^ (4 : ℕ) * w ^ (2 : ℕ) * ρ

/-- `-λ(ρΞ - MΠ)`, the `bW` of the spin `-t`. -/
noncomputable def bWnW (u a w P ρ M : ℂ) : ℂ :=
    -4 * u ^ (4 : ℕ) * a ^ (2 : ℕ) * ρ + 4 * u ^ (4 : ℕ) * a ^ (2 : ℕ) * M
    + 16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * ρ ^ (3 : ℕ)
    + 16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * ρ ^ (2 : ℕ) * M
    - 16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * ρ * M ^ (2 : ℕ) - 8 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * ρ
    - 16 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * M ^ (3 : ℕ) + 8 * u ^ (2 : ℕ) * a ^ (4 : ℕ) * M
    + 2 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * w ^ (2 : ℕ) * ρ
    - 2 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * w ^ (2 : ℕ) * M + 32 * a ^ (6 : ℕ) * P * ρ
    + 32 * a ^ (6 : ℕ) * P * M - 16 * a ^ (6 : ℕ) * ρ ^ (3 : ℕ)
    - 16 * a ^ (6 : ℕ) * ρ ^ (2 : ℕ) * M + 16 * a ^ (6 : ℕ) * ρ * M ^ (2 : ℕ)
    - 20 * a ^ (6 : ℕ) * ρ + 16 * a ^ (6 : ℕ) * M ^ (3 : ℕ) - 12 * a ^ (6 : ℕ) * M
    + 2 * a ^ (4 : ℕ) * w ^ (2 : ℕ) * ρ - 2 * a ^ (4 : ℕ) * w ^ (2 : ℕ) * M
    - (1 / 4) * a ^ (2 : ℕ) * w ^ (4 : ℕ) * ρ + (1 / 4) * a ^ (2 : ℕ) * w ^ (4 : ℕ) * M

/-- At a root of `E₈`, `a_tK_{-t} = b_tK_t`, Eq. (field-L-quotient). -/
theorem sym_z (u s a w β P ρ M : ℂ) (hE : E8W u a w P ρ M = 0) :
    aAW u a w P ρ M * KnW u s a w β P ρ M - bWW u a w P ρ M * KtW u s a w β P ρ M = 0 := by
  unfold E8W at hE
  unfold aAW KnW bWW KtW
  linear_combination (exp := 1) (
      -4 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * β * ρ - 4 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * β * M
      + 8 * u * a ^ (3 : ℕ) * β * ρ ^ (2 : ℕ) - 8 * u * a ^ (3 : ℕ) * β * M ^ (2 : ℕ)
      - 4 * a ^ (4 : ℕ) * β * ρ - 4 * a ^ (4 : ℕ) * β * M + a ^ (2 : ℕ) * w ^ (2 : ℕ) * β * ρ
      + a ^ (2 : ℕ) * w ^ (2 : ℕ) * β * M
    ) * hE

/-- At a root of `E₈`, the quotient identity of the spin `-t`. -/
theorem sym_v (u s a w β P ρ M : ℂ) (hE : E8W u a w P ρ M = 0) :
    anW u a w P ρ M * (GpSW u a w β P ρ M + GmSW u s a w β P ρ M) -
      bWnW u a w P ρ M * KnSW u s a w β P ρ M = 0 := by
  unfold E8W at hE
  unfold anW GpSW GmSW bWnW KnSW
  linear_combination (exp := 1) (
      -4 * u ^ (2 : ℕ) * s * a ^ (2 : ℕ) * β * ρ * M
      + 4 * u ^ (2 : ℕ) * s * a ^ (2 : ℕ) * β * M ^ (2 : ℕ)
      - 2 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * β ^ (2 : ℕ) * P * ρ
      + 2 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * β ^ (2 : ℕ) * P * M
      + 2 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * β ^ (2 : ℕ) * ρ
      - 2 * u ^ (2 : ℕ) * a ^ (2 : ℕ) * β ^ (2 : ℕ) * M
      + 8 * u * s * a ^ (3 : ℕ) * β * ρ ^ (2 : ℕ) * M - 8 * u * s * a ^ (3 : ℕ) * β * M ^ (3 : ℕ)
      + 4 * u * a ^ (3 : ℕ) * β ^ (2 : ℕ) * P * ρ ^ (2 : ℕ)
      - 4 * u * a ^ (3 : ℕ) * β ^ (2 : ℕ) * P * M ^ (2 : ℕ)
      - 4 * u * a ^ (3 : ℕ) * β ^ (2 : ℕ) * ρ ^ (2 : ℕ)
      + 4 * u * a ^ (3 : ℕ) * β ^ (2 : ℕ) * M ^ (2 : ℕ) - 4 * s * a ^ (4 : ℕ) * β * ρ * M
      + 4 * s * a ^ (4 : ℕ) * β * M ^ (2 : ℕ) + s * a ^ (2 : ℕ) * w ^ (2 : ℕ) * β * ρ * M
      - s * a ^ (2 : ℕ) * w ^ (2 : ℕ) * β * M ^ (2 : ℕ) - 2 * a ^ (4 : ℕ) * β ^ (2 : ℕ) * P * ρ
      + 2 * a ^ (4 : ℕ) * β ^ (2 : ℕ) * P * M + 2 * a ^ (4 : ℕ) * β ^ (2 : ℕ) * ρ
      - 2 * a ^ (4 : ℕ) * β ^ (2 : ℕ) * M
      + (1 / 2) * a ^ (2 : ℕ) * w ^ (2 : ℕ) * β ^ (2 : ℕ) * P * ρ
      - (1 / 2) * a ^ (2 : ℕ) * w ^ (2 : ℕ) * β ^ (2 : ℕ) * P * M
      - (1 / 2) * a ^ (2 : ℕ) * w ^ (2 : ℕ) * β ^ (2 : ℕ) * ρ
      + (1 / 2) * a ^ (2 : ℕ) * w ^ (2 : ℕ) * β ^ (2 : ℕ) * M
    ) * hE

/-- The part of `KtW` without `s`. -/
noncomputable def Kt0W (u a w β P ρ M : ℂ) : ℂ :=
    -u ^ (6 : ℕ) * β + 2 * u ^ (5 : ℕ) * a * β * ρ - 2 * u ^ (5 : ℕ) * a * β * M
