             RowBox[{RowBox[{"-", "vn"}], " ", "-", " ", "wpp"}]}], "}"}]}], 
       ";"}], "\n", RowBox[{RowBox[{"Bpp", " ", "=", " ", 
         RowBox[{RowBox[{RowBox[{"-", "beta"}], "/", "2"}], " ", 
