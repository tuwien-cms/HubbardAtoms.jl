                {RowBox[{"chiPP", "[", "\"s\"", "]"}], "[", "\"mir\"", 
                 "]"}]}], ",", " ", RowBox[{RowBox[{RowBox[{"chiPP", "[", 
                   "\"s\"", "]"}], "[", "\"dd\"", "]"}], " ", "+", " ", 
               RowBox[{RowBox[{"chiPP", "[", "\"s\"", "]"}], "[", "\"mir\"", 
                 "]"}]}]}], "}"}]}]}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"the two channels have the same bubble B, and B is the pp \
bubble\"", ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{"{", RowBox[{RowBox[{"BppT", " ", "+", " ", "mBppT"}], 
                 ",", " ", RowBox[{"BppT", " ", "-", " ", RowBox[{"toT", "[", 
                     RowBox[{RowBox[{"Bpp", " ", "/.", " ", "norm"}], ",", 
                       " ", "vn", ",", " ", "t"}], "]"}]}]}], "}"}], "]"}], 
           " ", "===", " ", RowBox[{"{", RowBox[{"0", ",", " ", "0"}], 
             "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"-", FractionBox[RowBox[{"beta", " ", 
             RowBox[{"(", RowBox[{RowBox[{RowBox[{"-", "2"}], " ", "a", " ", 
