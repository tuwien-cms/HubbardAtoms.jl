                     "/", RowBox[{"(", RowBox[{"s", " ", "-", " ", "s2"}], 
                       ")"}]}]}], ")"}]}], "]"}], " ", "===", " ", "0"}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"P - e is A v^2 + B\"", "\[Rule]", "True"}]], 
   "Output"], Cell[BoxData[RowBox[{"\"m, k = 0: the atomic pair has F_1 = \
P(a)/(a^2 - s2) = 0 and W(z; a^2) = 0\"", "\[Rule]", "True"}]], "Output"], 
