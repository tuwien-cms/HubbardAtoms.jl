                        {RowBox[{"(", RowBox[{"t", " ", "+", " ", "As"}], 
                          ")"}], "/", RowBox[{"PPt", "[", "t", "]"}]}]}]}], 
                   ",", " ", RowBox[{RowBox[{"PPt", "[", "t", "]"}], " ", 
                     "-", " ", RowBox[{RowBox[{"(", RowBox[{"t", " ", "-", 
                          " ", "tp"}], ")"}], " ", RowBox[{"(", RowBox[
                          {"t", " ", "-", " ", "tm"}], ")"}]}]}]}], "}"}], 
               " ", "/.", " ", "norm"}], "]"}], " ", "===", " ", 
           RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", 
               "0"}], "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[
     {"\"B, L_t, L_s as in the note; P(t) = (t - t+)(t - t-)\"", "\[Rule]", 
      "True"}]], "Output"], Cell["The generic part of chi_s, as a function of \
t_n, t_m: it is chi_s,reg of the note, Eq. (chi-s-num), with c = rho/b:", 
   "Text"], Cell[BoxData[{RowBox[{"chiSregT", " ", "=", " ", 
       RowBox[{"toT", "[", RowBox[{RowBox[{"toT", "[", 
             RowBox[{RowBox[{RowBox[{"chiPP", "[", "\"s\"", "]"}], "[", 
