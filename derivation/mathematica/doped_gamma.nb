                 "]"}]}], ",", " ", RowBox[{RowBox[{RowBox[{"chiPP", "[", 
                   "\"t\"", "]"}], "[", "\"dd\"", "]"}], " ", "-", " ", 
               RowBox[{RowBox[{"chiPP", "[", "\"t\"", "]"}], "[", "\"mir\"", 
                 "]"}]}]}], "}"}]}]}], "\n", 
     RowBox[{RowBox[{"{", RowBox[{"mBppT", ",", " ", "LsT"}], "}"}], " ", 
