           " ", "===", " ", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                  {RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}], ",", 
                   " ", RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}], 
                 "}"}], ",", " ", RowBox[{"{", RowBox[{RowBox[{"{", 
                     RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
                   RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}], 
                 "}"}]}], "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"Eq. (shift)\"", "\[Rule]", "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"S_+ and S_- at the zeros of P\"", "\[Rule]", 
      "True"}]], "Output"], Cell["Lemma \"values on the reflected lattice\": \
on the points -z_n, S_k is constant, S_k(-z_n) = (beta/2) coth(beta mu), and \
by the Riccati equation S_k'(-z_n) = beta^2/(4 sinh^2(beta mu)). With the \
weights: rho S_k(-z_n) = cbar := beta (p0 + p2)/2 and rho^2 S_k'(-z_n) = h^2 \
:= beta^2 p0 p2.", "Text"], 
  Cell[BoxData[{RowBox[{"check", "[", 
       RowBox[{"\"S_k on the reflected lattice\"", ",", " ", 
         RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"FullSimplify", "[", 
                 RowBox[{RowBox[{RowBox[{RowBox[{"Sk", "[", "par", "]"}], 
                       "[", RowBox[{"-", RowBox[{"(", RowBox[{"mu", " ", "+", 
                          " ", RowBox[{"I", " ", "Pi", " ", RowBox[{RowBox[
                          {"(", RowBox[{RowBox[{"2", " ", "n"}], " ", "+", 
                          " ", "1", " ", "+", " ", RowBox[{"2", " ", "kk"}], 
                          " ", "+", " ", "par"}], ")"}], "/", "beta"}]}]}], 
                          ")"}]}], "]"}], " ", "-", " ", RowBox[
                      {RowBox[{"beta", "/", "2"}], " ", RowBox[{"Coth", "[", 
                         RowBox[{"beta", " ", "mu"}], "]"}]}]}], ",", " ", 
                   RowBox[{"Element", "[", RowBox[{RowBox[{"{", RowBox[
                          {"n", ",", " ", "kk"}], "}"}], ",", " ", 
                       "Integers"}], "]"}]}], "]"}], ",", " ", RowBox[
                {"{", RowBox[{"par", ",", " ", RowBox[{"{", RowBox[{"0", ",", 
                       " ", "1"}], "}"}]}], "}"}]}], "]"}], " ", "===", " ", 
           RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}]}], "]"}], "\n", 
     RowBox[{RowBox[{"cbar", " ", "=", " ", RowBox[{"beta", " ", 
           RowBox[{RowBox[{"(", RowBox[{"p0", " ", "+", " ", "p2"}], ")"}], 
             "/", "2"}]}]}], ";", " ", RowBox[{"hsq", " ", "=", " ", 
         RowBox[{RowBox[{"beta", "^", "2"}], " ", "p0", " ", "p2"}]}], ";"}], 
     "\n", RowBox[{"check", "[", RowBox[{"\"rho S = cbar, rho^2 S' = h^2\"", 
         ",", " ", RowBox[{RowBox[{"FullSimplify", "[", 
             RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"rho", " ", 
                       RowBox[{"beta", "/", "2"}], " ", RowBox[{"Coth", "[", 
                         RowBox[{"beta", " ", "mu"}], "]"}]}], " ", "-", " ", 
                     "cbar"}], ",", " ", RowBox[{RowBox[{RowBox[{"rho", "^", 
                         "2"}], " ", RowBox[{"(", RowBox[{RowBox[{RowBox[
                          {"(", RowBox[{RowBox[{"beta", "/", "2"}], " ", 
                          RowBox[{"Coth", "[", RowBox[{"beta", " ", "mu"}], 
                          "]"}]}], ")"}], "^", "2"}], " ", "-", " ", RowBox[
                          {RowBox[{"beta", "^", "2"}], "/", "4"}]}], ")"}]}], 
                     " ", "-", " ", "hsq"}]}], "}"}], " ", "/.", " ", 
               "thermal"}], "]"}], " ", "===", " ", 
           RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}]}], "]"}]}], 
   "Input"], Cell[BoxData[RowBox[{"\"S_k on the reflected lattice\"", 
      "\[Rule]", "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"rho S = cbar, rho^2 S' = h^2\"", "\[Rule]", 
      "True"}]], "Output"], Cell["4 Singlet and triplet channels", 
   "Section"], 
  Cell["4.1 The particle-particle sum (Lemma \"particle-particle sum\")", 
   "Subsection"], Cell["With b = 2 mu - wpp and z_n = x_n + wpp/2: t_n = x_n \
(b - x_n) = b^2/4 - (z_n - mu)^2. For xi^2 = b^2/4 - t, partial fractions and \
the oddness of S give Sum_n 1/(t_n - t) = [S(mu - xi) - S(mu + xi)]/(2 xi) = \
-S(mu + xi)/xi =: T_k(t).", "Text"], 
  Cell[BoxData[{RowBox[{"check", "[", 
       RowBox[{"\"t_n = b^2/4 - (z_n - mu)^2\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[
                {RowBox[{"(", RowBox[{"mu", " ", "+", " ", "vn"}], ")"}], 
                 " ", RowBox[{"(", RowBox[{"bb", " ", "-", " ", "mu", " ", 
                     "-", " ", "vn"}], ")"}]}], " ", "-", " ", RowBox[
                {"(", RowBox[{RowBox[{RowBox[{"bb", "^", "2"}], "/", "4"}], 
                   " ", "-", " ", RowBox[{RowBox[{"(", RowBox[{"vn", " ", 
                         "+", " ", RowBox[{"wpp", "/", "2"}]}], ")"}], "^", 
                     "2"}]}], ")"}]}], "]"}], " ", "===", " ", "0"}]}], 
       "]"}], "\n", RowBox[{"check", "[", RowBox[{"\"partial fractions\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[{"xi", 
                       "^", "2"}], " ", "-", " ", RowBox[{"y", "^", "2"}]}], 
                   ")"}]}], " ", "-", " ", RowBox[{RowBox[{"(", RowBox[
                    {RowBox[{"1", "/", RowBox[{"(", RowBox[{"y", " ", "+", 
                          " ", "xi"}], ")"}]}], " ", "-", " ", RowBox[
                      {"1", "/", RowBox[{"(", RowBox[{"y", " ", "-", " ", 
                          "xi"}], ")"}]}]}], ")"}], "/", RowBox[
                  {"(", RowBox[{"2", " ", "xi"}], ")"}]}]}], "]"}], " ", 
           "===", " ", "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"t_n = b^2/4 - (z_n - mu)^2\"", "\[Rule]", 
      "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"partial fractions\"", "\[Rule]", "True"}]], 
   "Output"], Cell["At t+- = -a^2 +- a b: xi = a - b/2 gives mu + xi = a + \
wpp/2, a zero of Q_-, and xi = -a - b/2 gives mu + xi = -a + wpp/2, a zero of \
Q_+. So, by Section 3.1, T(t+) = -S_-/(a - b/2) and T(t-) = -S_+/(-a - b/2). \
T(-As) stays a symbol Ts.", "Text"], 
  Cell[BoxData[{RowBox[{"check", "[", RowBox[{"\"xi at t+-\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{"{", RowBox[
                {RowBox[{RowBox[{RowBox[{"(", RowBox[{"a", " ", "-", " ", 
