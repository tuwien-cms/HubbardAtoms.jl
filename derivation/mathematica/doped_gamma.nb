                          "2"}], " ", "-", " ", RowBox[{"4", " ", "to"}]}], 
                          "]"}]}], ")"}], "/", "2"}], " ", "-", " ", 
                   "mu"}]}]}], "]"}], "]"}]}], ";"}]}], "Input"], 
  Cell["On each orbit {n, nbar} a matrix d delta_nm + m delta_(m nbar) with \
mirror-invariant d, m acts as d + m on mirror-even and d - m on mirror-odd \
vectors. So chi_t = B M_+ + L_t M_- and chi_s = L_s M_+ - B M_- + chi_s,reg, \
with M_+- = (1 +- mirror)/2, where the eigenvalues are:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"{", RowBox[{"BppT", ",", " ", "LtT"}], 
         "}"}], " ", "=", " ", RowBox[
        {RowBox[{RowBox[{"toT", "[", RowBox[{"#", ",", " ", "vn", ",", " ", 
