  Cell[BoxData[RowBox[{"\"Eq. (chi-s-num)\"", "\[Rule]", "True"}]], 
   "Output"], Cell["3 Matsubara sums", "Section"], 
  Cell["At transfer k the centered lattice is z_n = mu + i pi (2n + 1 + \
k)/beta: the offsets z_n - mu are fermionic frequencies for even k and \
bosonic ones for odd k. par = Mod[k, 2]. Mathematica sums the symmetric \
Mittag-Leffler series in closed form:", "Text"], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"FullSimplify", "[", 
          RowBox[{"Sum", "[", RowBox[{RowBox[{RowBox[{"1", "/", RowBox[
                   {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"2", 
                          " ", "n"}], " ", "+", " ", "1"}], ")"}], " ", "I", 
                        " ", RowBox[{"Pi", "/", "beta"}]}], " ", "-", " ", 
                      "y"}], ")"}]}], " ", "+", " ", RowBox[{"1", "/", 
                  RowBox[{"(", RowBox[{RowBox[{RowBox[{"-", RowBox[{"(", 
                          RowBox[{RowBox[{"2", " ", "n"}], " ", "+", " ", 
                          "1"}], ")"}]}], " ", "I", " ", RowBox[{"Pi", "/", 
                          "beta"}]}], " ", "-", " ", "y"}], ")"}]}]}], ",", 
              " ", RowBox[{"{", RowBox[{"n", ",", " ", "0", ",", " ", 
                  "Infinity"}], "}"}]}], "]"}], "]"}], ",", "\n", " ", 
        RowBox[{"FullSimplify", "[", RowBox[{RowBox[{RowBox[{"-", "1"}], "/", 
              "y"}], " ", "+", " ", RowBox[{"Sum", "[", RowBox[{
                RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[
                         {"2", " ", "n", " ", "I", " ", RowBox[{"Pi", "/", 
                          "beta"}]}], " ", "-", " ", "y"}], ")"}]}], " ", 
                  "+", " ", RowBox[{"1", "/", RowBox[{"(", RowBox[
                       {RowBox[{RowBox[{"-", "2"}], " ", "n", " ", "I", " ", 
                          RowBox[{"Pi", "/", "beta"}]}], " ", "-", " ", 
                        "y"}], ")"}]}]}], ",", " ", RowBox[{"{", 
                  RowBox[{"n", ",", " ", "1", ",", " ", "Infinity"}], 
                  "}"}]}], "]"}]}], "]"}]}], "}"}]], "Input"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{RowBox[{"-", FractionBox["1", "2"]}], " ", "beta", 
          " ", RowBox[{"Tanh", "[", FractionBox[RowBox[{"beta", " ", "y"}], 
             "2"], "]"}]}], ",", RowBox[
         {RowBox[{"-", FractionBox["1", "2"]}], " ", "beta", " ", 
          RowBox[{"Coth", "[", FractionBox[RowBox[{"beta", " ", "y"}], "2"], 
            "]"}]}]}], "}"}]], "Output"], 
  Cell["So S_k(x) := PV Sum_n 1/(z_n - x) is (Lemma \"basic sum\"):", 
   "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{RowBox[{"Sk", "[", "0", "]"}], "[", "x_", "]"}], 
         " ", ":=", " ", RowBox[{RowBox[{RowBox[{"-", "beta"}], "/", "2"}], 
           " ", RowBox[{"Tanh", "[", RowBox[{"beta", " ", RowBox[
                {RowBox[{"(", RowBox[{"x", " ", "-", " ", "mu"}], ")"}], "/", 
                 "2"}]}], "]"}]}]}], ";", " ", 
       RowBox[{RowBox[{RowBox[{"Sk", "[", "1", "]"}], "[", "x_", "]"}], " ", 
         ":=", " ", RowBox[{RowBox[{RowBox[{"-", "beta"}], "/", "2"}], " ", 
           RowBox[{"Coth", "[", RowBox[{"beta", " ", RowBox[
                {RowBox[{"(", RowBox[{"x", " ", "-", " ", "mu"}], ")"}], "/", 
                 "2"}]}], "]"}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"S_k equals the two sums\"", ",", " ", 
         RowBox[{RowBox[{"FullSimplify", "[", RowBox[{"{", RowBox[
                {RowBox[{RowBox[{"Sum", "[", RowBox[{RowBox[{RowBox[{"1", 
                          "/", RowBox[{"(", RowBox[{RowBox[{RowBox[{"(", 
                          RowBox[{RowBox[{"2", " ", "n"}], " ", "+", " ", 
                          "1"}], ")"}], " ", "I", " ", RowBox[{"Pi", "/", 
                          "beta"}]}], " ", "-", " ", "y"}], ")"}]}], " ", 
                         "+", " ", RowBox[{"1", "/", RowBox[{"(", RowBox[
                          {RowBox[{RowBox[{"-", RowBox[{"(", RowBox[{RowBox[
                          {"2", " ", "n"}], " ", "+", " ", "1"}], ")"}]}], 
                          " ", "I", " ", RowBox[{"Pi", "/", "beta"}]}], " ", 
                          "-", " ", "y"}], ")"}]}]}], ",", " ", RowBox[
                        {"{", RowBox[{"n", ",", " ", "0", ",", " ", 
                          "Infinity"}], "}"}]}], "]"}], " ", "-", " ", 
                   RowBox[{RowBox[{"Sk", "[", "0", "]"}], "[", RowBox[
                      {"y", " ", "+", " ", "mu"}], "]"}]}], ",", "\n", 
                 "    ", RowBox[{RowBox[{RowBox[{"-", "1"}], "/", "y"}], " ", 
                   "+", " ", RowBox[{"Sum", "[", RowBox[{RowBox[{RowBox[
                          {"1", "/", RowBox[{"(", RowBox[{RowBox[{"2", " ", 
                          "n", " ", "I", " ", RowBox[{"Pi", "/", "beta"}]}], 
                          " ", "-", " ", "y"}], ")"}]}], " ", "+", " ", 
                         RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[
                          {RowBox[{"-", "2"}], " ", "n", " ", "I", " ", 
                          RowBox[{"Pi", "/", "beta"}]}], " ", "-", " ", 
                          "y"}], ")"}]}]}], ",", " ", RowBox[{"{", RowBox[
                          {"n", ",", " ", "1", ",", " ", "Infinity"}], 
                         "}"}]}], "]"}], " ", "-", " ", RowBox[
                    {RowBox[{"Sk", "[", "1", "]"}], "[", RowBox[{"y", " ", 
                       "+", " ", "mu"}], "]"}]}]}], "}"}], "]"}], " ", "===", 
           " ", RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"S_k equals the two sums\"", "\[Rule]", "True"}]], 
   "Output"], Cell["Both satisfy the Riccati equation S' = S^2 - beta^2/4, \
and S_k(mu + y) is odd in y. So every derivative of S at a point follows from \
its value there: sTaylor[s0, d, order] is the Taylor polynomial of S(x0 + d) \
when S(x0) = s0.", "Text"], 
  Cell[BoxData[{RowBox[{"check", "[", 
       RowBox[{"\"Riccati equation and oddness\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{"Flatten", "[", RowBox[
                {"Table", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[
                        {RowBox[{"D", "[", RowBox[{RowBox[{RowBox[{"Sk", "[", 
                          "par", "]"}], "[", "x", "]"}], ",", " ", "x"}], 
                          "]"}], " ", "-", " ", RowBox[{"(", RowBox[
                          {RowBox[{RowBox[{RowBox[{"Sk", "[", "par", "]"}], 
                          "[", "x", "]"}], "^", "2"}], " ", "-", " ", RowBox[
                          {RowBox[{"beta", "^", "2"}], "/", "4"}]}], ")"}]}], 
                       ",", " ", RowBox[{RowBox[{RowBox[{"Sk", "[", "par", 
                          "]"}], "[", RowBox[{"mu", " ", "+", " ", "y"}], 
                          "]"}], " ", "+", " ", RowBox[{RowBox[{"Sk", "[", 
                          "par", "]"}], "[", RowBox[{"mu", " ", "-", " ", 
                          "y"}], "]"}]}]}], "}"}], ",", " ", RowBox[
                    {"{", RowBox[{"par", ",", " ", RowBox[{"{", RowBox[
                          {"0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], 
               "]"}], "]"}], " ", "===", " ", RowBox[
            {"{", RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
             "}"}]}]}], "]"}], "\n", 
     RowBox[{RowBox[{RowBox[{"sTaylor", "[", RowBox[{"s0_", ",", " ", "d_", 
             ",", " ", "order_"}], "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                {RowBox[{"poly", " ", "=", " ", "s0"}], ",", " ", "tt"}], 
               "}"}], ",", " ", RowBox[{RowBox[{"Do", "[", RowBox[
                  {RowBox[{RowBox[{"poly", " ", "=", " ", RowBox[{"s0", " ", 
                         "+", " ", RowBox[{"Integrate", "[", RowBox[
                          {RowBox[{"Expand", "[", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"poly", "^", "2"}], " ", "-", " ", RowBox[
                          {RowBox[{"beta", "^", "2"}], "/", "4"}]}], ")"}], 
                          " ", "/.", " ", RowBox[{"d", " ", "->", " ", 
                          "tt"}]}], "]"}], ",", " ", RowBox[{"{", RowBox[
                          {"tt", ",", " ", "0", ",", " ", "d"}], "}"}]}], 
                          "]"}]}]}], ";", " ", RowBox[{"poly", " ", "=", " ", 
                       RowBox[{"Normal", "[", RowBox[{"Series", "[", RowBox[
                          {"poly", ",", " ", RowBox[{"{", RowBox[{"d", ",", 
                          " ", "0", ",", " ", "order"}], "}"}]}], "]"}], 
