                          RowBox[{"resS", "[", RowBox[{"phi", ",", " ", "tt", 
                          ",", " ", RowBox[{"-", "1"}], ",", " ", "1", ",", 
                          " ", RowBox[{RowBox[{"Sk", "[", "0", "]"}], "[", 
