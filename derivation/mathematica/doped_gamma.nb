                          {"bb", "^", "2"}], "/", "4"}], " ", "-", " ", 
                       "tm"}], ")"}]}], ",", " ", RowBox[{"mu", " ", "-", 
                   " ", "a", " ", "-", " ", RowBox[{"bb", "/", "2"}], " ", 
                   "-", " ", RowBox[{"(", RowBox[{RowBox[{"-", "a"}], " ", 
                       "+", " ", RowBox[{"wpp", "/", "2"}]}], ")"}]}]}], 
               "}"}], "]"}], " ", "===", " ", RowBox[
            {"{", RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
             "}"}]}]}], "]"}], "\n", 
     RowBox[{RowBox[{"Tval", " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"tp", ",", " ", 
                 RowBox[{RowBox[{"-", "Sminus"}], "/", RowBox[{"(", 
                     RowBox[{"a", " ", "-", " ", RowBox[{"bb", "/", "2"}]}], 
                     ")"}]}]}], "}"}], ",", " ", RowBox[{"{", RowBox[
                {"tm", ",", " ", RowBox[{RowBox[{"-", "Splus"}], "/", 
                   RowBox[{"(", RowBox[{RowBox[{"-", "a"}], " ", "-", " ", 
                       RowBox[{"bb", "/", "2"}]}], ")"}]}]}], "}"}], ",", 
             " ", RowBox[{"{", RowBox[{RowBox[{"-", "As"}], ",", " ", "Ts"}], 
               "}"}]}], "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"tAt", "[", "y_", "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"hit", " ", "=", 
                 " ", RowBox[{"Select", "[", RowBox[{"Tval", ",", " ", 
                     RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                          {RowBox[{"(", RowBox[{"y", " ", "-", " ", RowBox[
                          {"#", "[", RowBox[{"[", "1", "]"}], "]"}]}], ")"}], 
                          " ", "/.", " ", "norm"}], "]"}], " ", "===", " ", 
                         "0"}], " ", "&"}]}], "]"}]}], "}"}], ",", " ", 
             RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "hit", 
                     "]"}], " ", "==", " ", "1"}], ",", " ", RowBox[
                  {"hit", "[", RowBox[{"[", RowBox[{"1", ",", " ", "2"}], 
                     "]"}], "]"}], ",", " ", "$Failed"}], "]"}]}], "]"}]}], 
       ";"}], "\n", RowBox[
      {RowBox[{RowBox[{RowBox[{"tsum", "[", RowBox[{"phi_", ",", " ", "t_"}], 
             "]"}], " ", ":=", " ", RowBox[{"Module", "[", 
             RowBox[{RowBox[{"{", RowBox[{RowBox[{"f", " ", "=", " ", 
                     RowBox[{"Together", "[", "phi", "]"}]}], ",", " ", 
                   "poles"}], "}"}], ",", "\n", "  ", RowBox[
                {RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Limit", "[", 
                         RowBox[{"f", ",", " ", RowBox[{"t", " ", "->", " ", 
                          "Infinity"}]}], "]"}], " ", "=!=", " ", "0"}], ",", 
                     " ", RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], 
                 ";", "\n", "  ", RowBox[{"poles", " ", "=", " ", 
                   RowBox[{"Union", "[", RowBox[{"Simplify", "[", RowBox[
                        {"t", " ", "/.", " ", RowBox[{"Solve", "[", RowBox[
                          {RowBox[{RowBox[{"Denominator", "[", "f", "]"}], 
                          " ", "==", " ", "0"}], ",", " ", "t"}], "]"}]}], 
                       "]"}], "]"}]}], ";", "\n", "  ", RowBox[{"Sum", "[", 
