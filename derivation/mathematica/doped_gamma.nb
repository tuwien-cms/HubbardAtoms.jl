                 ",", " ", RowBox[{"mu", " ", "+", " ", "a", " ", "-", " ", 
                   RowBox[{"bb", "/", "2"}], " ", "-", " ", RowBox[
                    {"(", RowBox[{"a", " ", "+", " ", RowBox[{"wpp", "/", 
                         "2"}]}], ")"}]}], ",", " ", RowBox[
                  {RowBox[{RowBox[{"(", RowBox[{RowBox[{"-", "a"}], " ", "-", 
