       RowBox[{"tm", " ", "=", " ", RowBox[
          {RowBox[{"-", RowBox[{"a", "^", "2"}]}], " ", "-", " ", 
           RowBox[{"a", " ", "bb"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"PPt", "[", "t_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{"(", RowBox[{"t", " ", "+", " ", 
