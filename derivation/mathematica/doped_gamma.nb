Notebook[{Cell["The irreducible vertex of the doped Hubbard atom", "Title"], 
  Cell["A computer-algebra companion to the note doped-gamma-derivation \
(derivation/ in HubbardAtoms.jl). It starts from the Hamiltonian, derives the \
generalized susceptibility from the Lehmann representation (replacing the \
note's one external input, Ref. [Essl et al. 2024, Eq. (D3)]), and then \
replays the inversion of the note step by step. Objects are computed from \
earlier results where possible: H, lambda, N, B, L_s, L_t, gamma_+-, the \
coefficients D_v, E_v of Step 1, the polynomial W of Eq. (source), and the \
singlet and triplet vertices are extracted, not typed in. The note's formulas \
are typed in only to compare with. Each comparison goes through check[label, \
value]; the last section lists all of them.", "Text"], 
  Cell["Scope. Symbolic: the input, all rational identities and lattice sums \
of the proofs, the pp theorems, and Steps 1-4 of the proof for the density \
and magnetic channels (the final assembly of Step 4 is checked through its \
two identities). Numerical: every theorem, including half filling and its \
limit mu -> 0, against brute-force inversion of the Section 1 susceptibility \
on finite frequency boxes, and a genuine divergence. Not reproduced, only \
argued in the note: the analytic statements (convergence, continuity in mu \
and beta, the finite-box limit, the exceptional parameter sets). The \
inversion strategy itself (multiplying by P, the Cauchy-column ansatz, the \
pole pairs) is taken from the note; the notebook executes it.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"$checks", " ", "=", " ", 
         RowBox[{"{", "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"check", "[", RowBox[{"label_String", ",", " ", 
             "value_"}], "]"}], " ", ":=", " ", 
         RowBox[{"(", RowBox[{RowBox[{"AppendTo", "[", RowBox[{"$checks", 
                 ",", " ", RowBox[{"label", " ", "->", " ", RowBox[{"TrueQ", 
                     "[", RowBox[{"And", " ", "@@", " ", RowBox[{"Flatten", 
                         "[", RowBox[{"{", "value", "}"}], "]"}]}], 
                     "]"}]}]}], "]"}], ";", " ", RowBox[{"Last", "[", 
               "$checks", "]"}]}], ")"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"SetOptions", "[", RowBox[{"$Output", ",", " ", 
           RowBox[{"PageWidth", " ", "->", " ", "120"}]}], "]"}], ";"}]}], 
   "Input"], Cell["1 The atom and its correlation functions", "Section"], 
  Cell["Fock states |0>, |up>, |dn>, |updn> = c_up^+ c_dn^+ |0>. Hamiltonian \
H = U (n_up - 1/2)(n_dn - 1/2) - mu (n_up + n_dn - 1) with a = U/2. Its \
eigenvalues E_i and Boltzmann weights p0, p1, p1, p2 (p1 for each singly \
occupied state); the weights stay symbols until they are needed.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"cupD", " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", 
                 " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", 
                 " ", "0"}], "}"}], ",", " ", RowBox[{"{", RowBox[
                {"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], 
             ",", " ", RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", " ", 
                 "1", ",", " ", "0"}], "}"}]}], "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"cdnD", " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", 
                 " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", 
                 " ", "0"}], "}"}], ",", " ", RowBox[{"{", RowBox[
                {"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], 
             ",", " ", RowBox[{"{", RowBox[{"0", ",", " ", RowBox[
                  {"-", "1"}], ",", " ", "0", ",", " ", "0"}], "}"}]}], 
           "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"cup", " ", "=", " ", RowBox[{"Transpose", "[", "cupD", 
           "]"}]}], ";", " ", RowBox[{"cdn", " ", "=", " ", 
         RowBox[{"Transpose", "[", "cdnD", "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"nup", " ", "=", " ", RowBox[{"cupD", " ", ".", " ", 
           "cup"}]}], ";", " ", RowBox[{"ndn", " ", "=", " ", 
         RowBox[{"cdnD", " ", ".", " ", "cdn"}]}], ";", " ", 
       RowBox[{"id4", " ", "=", " ", RowBox[{"IdentityMatrix", "[", "4", 
           "]"}]}], ";"}], "\n", RowBox[{"check", "[", 
       RowBox[{"\"canonical anticommutators\"", ",", " ", 
         RowBox[{"{", RowBox[{RowBox[{RowBox[{RowBox[{"cup", " ", ".", " ", 
                   "cdn"}], " ", "+", " ", RowBox[{"cdn", " ", ".", " ", 
                   "cup"}]}], " ", "==", " ", RowBox[{"0", " ", "id4"}]}], 
             ",", " ", RowBox[{RowBox[{RowBox[{"cup", " ", ".", " ", 
                   "cupD"}], " ", "+", " ", RowBox[{"cupD", " ", ".", " ", 
                   "cup"}]}], " ", "==", " ", "id4"}], ",", " ", 
             RowBox[{RowBox[{RowBox[{"cdn", " ", ".", " ", "cdnD"}], " ", 
                 "+", " ", RowBox[{"cdnD", " ", ".", " ", "cdn"}]}], " ", 
               "==", " ", "id4"}], ",", " ", RowBox[{RowBox[
                {RowBox[{"cup", " ", ".", " ", "cdnD"}], " ", "+", " ", 
                 RowBox[{"cdnD", " ", ".", " ", "cup"}]}], " ", "==", " ", 
               RowBox[{"0", " ", "id4"}]}]}], "}"}]}], "]"}], "\n", 
     RowBox[{RowBox[{"ham", " ", "=", " ", 
         RowBox[{RowBox[{"2", " ", "a", " ", RowBox[{RowBox[{"(", 
                 RowBox[{"nup", " ", "-", " ", RowBox[{"id4", "/", "2"}]}], 
                 ")"}], " ", ".", " ", RowBox[{"(", RowBox[{"ndn", " ", "-", 
                   " ", RowBox[{"id4", "/", "2"}]}], ")"}]}]}], " ", "-", 
           " ", RowBox[{"mu", " ", RowBox[{"(", RowBox[{"nup", " ", "+", " ", 
                 "ndn", " ", "-", " ", "id4"}], ")"}]}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"H is diagonal\"", ",", " ", 
         RowBox[{RowBox[{"DiagonalMatrix", "[", RowBox[{"Diagonal", "[", 
               "ham", "]"}], "]"}], " ", "==", " ", "ham"}]}], "]"}], "\n", 
     RowBox[{"energy", " ", "=", " ", RowBox[{"Diagonal", "[", "ham", 
         "]"}]}], "\n", RowBox[{RowBox[{"weight", " ", "=", " ", 
         RowBox[{"{", RowBox[{"p0", ",", " ", "p1", ",", " ", "p1", ",", " ", 
             "p2"}], "}"}]}], ";"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"canonical anticommutators\"", "\[Rule]", "True"}]], 
   "Output"], Cell[BoxData[RowBox[{"\"H is diagonal\"", "\[Rule]", "True"}]], 
   "Output"], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{FractionBox["a", "2"], "+", 
          "mu"}], ",", RowBox[{"-", FractionBox["a", "2"]}], ",", 
        RowBox[{"-", FractionBox["a", "2"]}], ",", 
        RowBox[{FractionBox["a", "2"], "-", "mu"}]}], "}"}]], "Output"], 
  Cell["Imaginary-time correlators. With O(tau) = e^(tau H) O e^(-tau H), the \
integrand of a time-ordered correlator on the ordering beta > t_1 > ... > t_n \
> 0 is a sum of exponentials e^(x_1 t_1 + ... + x_n t_n). Its integral over \
that simplex is the divided difference of e^(beta s) at the nodes 0, x_1, x_1 \
+ x_2, ...:", "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"divdiff", "[", RowBox[{"nodes_List", ",", " ", 
             "vals_List"}], "]"}], " ", ":=", " ", 
         RowBox[{"Sum", "[", RowBox[{RowBox[{RowBox[{"vals", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "/", RowBox[{"Product", "[", 
                 RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"j", " ", "==", 
                         " ", "i"}], ",", " ", "1", ",", " ", RowBox[
                        {RowBox[{"nodes", "[", RowBox[{"[", "i", "]"}], 
                          "]"}], " ", "-", " ", RowBox[{"nodes", "[", RowBox[
                          {"[", "j", "]"}], "]"}]}]}], "]"}], ",", " ", 
                   RowBox[{"{", RowBox[{"j", ",", " ", RowBox[{"Length", "[", 
                         "nodes", "]"}]}], "}"}]}], "]"}]}], ",", " ", 
             RowBox[{"{", RowBox[{"i", ",", " ", RowBox[{"Length", "[", 
                   "nodes", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"simplex integral = divided difference\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"Integrate", "[", 
                 RowBox[{RowBox[{"Exp", "[", RowBox[{RowBox[{"x1", " ", 
                         "t1"}], " ", "+", " ", RowBox[{"x2", " ", "t2"}], 
                       " ", "+", " ", RowBox[{"x3", " ", "t3"}]}], "]"}], 
                   ",", " ", RowBox[{"{", RowBox[{"t1", ",", " ", "0", ",", 
                       " ", "beta"}], "}"}], ",", " ", RowBox[{"{", 
                     RowBox[{"t2", ",", " ", "0", ",", " ", "t1"}], "}"}], 
                   ",", " ", RowBox[{"{", RowBox[{"t3", ",", " ", "0", ",", 
                       " ", "t2"}], "}"}]}], "]"}], " ", "-", " ", RowBox[
                {"divdiff", "[", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", 
                       "x1", ",", " ", RowBox[{"x1", " ", "+", " ", "x2"}], 
                       ",", " ", RowBox[{"x1", " ", "+", " ", "x2", " ", "+", 
                         " ", "x3"}]}], "}"}], ",", " ", RowBox[{"Exp", "[", 
                     RowBox[{"beta", " ", RowBox[{"{", RowBox[{"0", ",", " ", 
                          "x1", ",", " ", RowBox[{"x1", " ", "+", " ", 
                          "x2"}], ",", " ", RowBox[{"x1", " ", "+", " ", 
                          "x2", " ", "+", " ", "x3"}]}], "}"}]}], "]"}]}], 
                 "]"}]}], "]"}], " ", "==", " ", "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"simplex integral = divided difference\"", 
      "\[Rule]", "True"}]], "Output"], Cell["correlator[ops, phis, point] is \
Int dtau_1 ... dtau_n e^(phi_1 . f tau_1 + ... + phi_n . f tau_n) Tr[e^(-beta \
H) T O_1(tau_1) ... O_n(tau_n) O_(n+1)(0)]/Z for fermionic operators O_i, \
with f = {vn, vm, w} = {i nu, i nu', i omega} and integer coefficient vectors \
phi_j, at Matsubara frequencies obeying the relations point (e.g. {w -> 0}). \
The sum runs over time orderings (sign of the permutation) and closed paths \
of states s_1 -> ... -> s_(n+1) -> s_1. Node j is x_j = E_(s_1) - E_(s_j) + \
(frequencies so far), and p_(s_1) e^(beta x_j) = p_(s_j) e^(beta c_j . f) = \
p_(s_j) (-1)^(c_j1 + c_j2) at Matsubara frequencies. Where nodes coincide, \
the divided difference is confluent: equal nodes are grouped, and m equal \
nodes give f^(m-1)(x)/(m-1)! = beta^(m-1) e^(beta x)/(m-1)!. No limits are \
needed.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"freqs", " ", "=", " ", 
         RowBox[{"{", RowBox[{"vn", ",", " ", "vm", ",", " ", "w"}], "}"}]}], 
       ";"}], "\n", RowBox[{RowBox[{RowBox[{"ddExp", "[", "nv_List", "]"}], 
         " ", ":=", " ", RowBox[{"Which", "[", 
           RowBox[{RowBox[{RowBox[{"Length", "[", "nv", "]"}], " ", "==", 
               " ", "1"}], ",", " ", RowBox[{"nv", "[", RowBox[
                {"[", RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", "\n", 
             "   ", RowBox[{RowBox[{"Expand", "[", RowBox[{RowBox[{"nv", "[", 
                     RowBox[{"[", RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], 
                   " ", "-", " ", RowBox[{"nv", "[", RowBox[{"[", RowBox[
                        {RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], "]"}]}], 
                 "]"}], " ", "===", " ", "0"}], ",", " ", 
             RowBox[{RowBox[{"beta", "^", RowBox[{"(", RowBox[
                    {RowBox[{"Length", "[", "nv", "]"}], " ", "-", " ", 
                     "1"}], ")"}]}], " ", RowBox[{RowBox[{"nv", "[", 
                   RowBox[{"[", RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], 
                 "/", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Length", "[", 
                         "nv", "]"}], " ", "-", " ", "1"}], ")"}], "!"}]}]}], 
             ",", "\n", "   ", "True", ",", " ", RowBox[{RowBox[
                {"(", RowBox[{RowBox[{"ddExp", "[", RowBox[{"Rest", "[", 
                       "nv", "]"}], "]"}], " ", "-", " ", RowBox[{"ddExp", 
                     "[", RowBox[{"Most", "[", "nv", "]"}], "]"}]}], ")"}], 
               "/", RowBox[{"(", RowBox[{RowBox[{"nv", "[", RowBox[{"[", 
                       RowBox[{RowBox[{"-", "1"}], ",", " ", "1"}], "]"}], 
                     "]"}], " ", "-", " ", RowBox[{"nv", "[", RowBox[
                      {"[", RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], 
                 ")"}]}]}], "]"}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"divided difference of Exp, distinct nodes\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"ddExp", "[", 
                 RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"x1", ",", " ", 
                         RowBox[{"Exp", "[", RowBox[{"beta", " ", "x1"}], 
                          "]"}]}], "}"}], ",", " ", RowBox[{"{", RowBox[
                        {"x2", ",", " ", RowBox[{"Exp", "[", RowBox[{"beta", 
                          " ", "x2"}], "]"}]}], "}"}], ",", " ", RowBox[
                      {"{", RowBox[{"x3", ",", " ", RowBox[{"Exp", "[", 
                          RowBox[{"beta", " ", "x3"}], "]"}]}], "}"}]}], 
                   "}"}], "]"}], " ", "-", " ", RowBox[{"divdiff", "[", 
                 RowBox[{RowBox[{"{", RowBox[{"x1", ",", " ", "x2", ",", " ", 
                       "x3"}], "}"}], ",", " ", RowBox[{"Exp", "[", 
                     RowBox[{"beta", " ", RowBox[{"{", RowBox[{"x1", ",", 
                          " ", "x2", ",", " ", "x3"}], "}"}]}], "]"}]}], 
                 "]"}]}], "]"}], " ", "===", " ", "0"}]}], "]"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"confluent divided difference = limit\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"ddExp", "[", 
                 RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"x1", ",", " ", 
                         RowBox[{"Exp", "[", RowBox[{"beta", " ", "x1"}], 
                          "]"}]}], "}"}], ",", " ", RowBox[{"{", RowBox[
                        {"x1", ",", " ", RowBox[{"Exp", "[", RowBox[{"beta", 
                          " ", "x1"}], "]"}]}], "}"}], ",", " ", RowBox[
                      {"{", RowBox[{"x3", ",", " ", RowBox[{"Exp", "[", 
                          RowBox[{"beta", " ", "x3"}], "]"}]}], "}"}]}], 
                   "}"}], "]"}], " ", "-", " ", RowBox[{"Limit", "[", 
                 RowBox[{RowBox[{"divdiff", "[", RowBox[{RowBox[{"{", 
                         RowBox[{"x1", ",", " ", "x2", ",", " ", "x3"}], 
                         "}"}], ",", " ", RowBox[{"Exp", "[", RowBox[{"beta", 
                          " ", RowBox[{"{", RowBox[{"x1", ",", " ", "x2", 
                          ",", " ", "x3"}], "}"}]}], "]"}]}], "]"}], ",", 
                   " ", RowBox[{"x2", " ", "->", " ", "x1"}]}], "]"}]}], 
             "]"}], " ", "===", " ", "0"}]}], "]"}], "\n", 
     RowBox[{RowBox[{RowBox[{"correlator", "[", RowBox[{"ops_", ",", " ", 
             "phis_", ",", " ", RowBox[{"point_", " ", ":", " ", RowBox[
                {"{", "}"}]}]}], "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                {RowBox[{"n", " ", "=", " ", RowBox[{"Length", "[", "phis", 
                     "]"}]}], ",", " ", RowBox[{"total", " ", "=", " ", 
                   "0"}]}], "}"}], ",", "\n", "  ", 
             RowBox[{RowBox[{"Do", "[", "\n", "   ", RowBox[
                  {RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{"string", " ", "=", " ", RowBox[{"Append", 
                          "[", RowBox[{RowBox[{"ops", "[", RowBox[{"[", 
                          "perm", "]"}], "]"}], ",", " ", RowBox[{"Last", 
                          "[", "ops", "]"}]}], "]"}]}], ",", " ", RowBox[
                          {"ph", " ", "=", " ", RowBox[{"phis", "[", RowBox[
                          {"[", "perm", "]"}], "]"}]}], ",", " ", RowBox[
                          {"sgn", " ", "=", " ", RowBox[{"Signature", "[", 
                          "perm", "]"}]}]}], "}"}], ",", "\n", "    ", 
                       RowBox[{"Do", "[", "\n", "     ", RowBox[{RowBox[
                          {"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{"amp", " ", "=", " ", RowBox[{"Product", 
                          "[", RowBox[{RowBox[{"string", "[", RowBox[{"[", 
                          RowBox[{"j", ",", " ", RowBox[{"path", "[", RowBox[
                          {"[", "j", "]"}], "]"}], ",", " ", RowBox[{"path", 
                          "[", RowBox[{"[", RowBox[{"j", " ", "+", " ", 
                          "1"}], "]"}], "]"}]}], "]"}], "]"}], ",", " ", 
                          RowBox[{"{", RowBox[{"j", ",", " ", RowBox[{"n", 
                          " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], ",", " ", 
                          "cum", ",", " ", "nv"}], "}"}], ",", "\n", 
                          "      ", RowBox[{"If", "[", RowBox[{RowBox[{"amp", 
                          " ", "=!=", " ", "0"}], ",", "\n", "       ", 
                          RowBox[{RowBox[{"cum", " ", "=", " ", RowBox[
                          {"FoldList", "[", RowBox[{"Plus", ",", " ", RowBox[
                          {"{", RowBox[{"0", ",", " ", "0", ",", " ", "0"}], 
                          "}"}], ",", " ", "ph"}], "]"}]}], ";", "\n", 
                          "       ", RowBox[{"nv", " ", "=", " ", RowBox[
                          {"Table", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[
                          {RowBox[{"energy", "[", RowBox[{"[", RowBox[
                          {"path", "[", RowBox[{"[", "1", "]"}], "]"}], 
                          "]"}], "]"}], " ", "-", " ", RowBox[{"energy", "[", 
                          RowBox[{"[", RowBox[{"path", "[", RowBox[{"[", "j", 
                          "]"}], "]"}], "]"}], "]"}], " ", "+", " ", RowBox[
                          {RowBox[{"cum", "[", RowBox[{"[", "j", "]"}], 
                          "]"}], " ", ".", " ", RowBox[{"(", RowBox[{"freqs", 
                          " ", "/.", " ", "point"}], ")"}]}]}], ",", "\n", 
                          "          ", RowBox[{RowBox[{"weight", "[", RowBox[
                          {"[", RowBox[{"path", "[", RowBox[{"[", "j", "]"}], 
                          "]"}], "]"}], "]"}], " ", RowBox[{RowBox[{"(", 
                          RowBox[{"-", "1"}], ")"}], "^", RowBox[{"(", RowBox[
                          {RowBox[{"cum", "[", RowBox[{"[", RowBox[{"j", ",", 
                          " ", "1"}], "]"}], "]"}], " ", "+", " ", RowBox[
                          {"cum", "[", RowBox[{"[", RowBox[{"j", ",", " ", 
                          "2"}], "]"}], "]"}]}], ")"}]}]}]}], "}"}], ",", 
                          " ", RowBox[{"{", RowBox[{"j", ",", " ", RowBox[
                          {"n", " ", "+", " ", "1"}]}], "}"}]}], "]"}]}], 
                          ";", "\n", "       ", RowBox[{"total", " ", "+=", 
                          " ", RowBox[{"sgn", " ", "amp", " ", RowBox[
                          {"ddExp", "[", RowBox[{"Flatten", "[", RowBox[
                          {RowBox[{"GatherBy", "[", RowBox[{"nv", ",", " ", 
                          RowBox[{RowBox[{"Expand", "[", RowBox[{"#", "[", 
                          RowBox[{"[", "1", "]"}], "]"}], "]"}], " ", 
                          "&"}]}], "]"}], ",", " ", "1"}], "]"}], 
                          "]"}]}]}]}]}], "]"}]}], "]"}], ",", "\n", "     ", 
                          RowBox[{"{", RowBox[{"path", ",", " ", RowBox[
                          {RowBox[{RowBox[{"Append", "[", RowBox[{"#", ",", 
                          " ", RowBox[{"First", "[", "#", "]"}]}], "]"}], 
                          " ", "&"}], " ", "/@", " ", RowBox[{"Tuples", "[", 
                          RowBox[{RowBox[{"Range", "[", "4", "]"}], ",", " ", 
                          RowBox[{"n", " ", "+", " ", "1"}]}], "]"}]}]}], 
                          "}"}]}], "]"}]}], "]"}], ",", "\n", "   ", 
                   RowBox[{"{", RowBox[{"perm", ",", " ", RowBox[
                        {"Permutations", "[", RowBox[{"Range", "[", "n", 
                          "]"}], "]"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
               RowBox[{"Together", "[", "total", "]"}]}]}], "]"}]}], ";"}]}], 
   "Input"], 
  Cell[BoxData[RowBox[{"\"divided difference of Exp, distinct nodes\"", 
      "\[Rule]", "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"confluent divided difference = limit\"", "\[Rule]", 
      "True"}]], "Output"], Cell["The propagator G(nu) = -Int dtau e^(i nu \
tau) <T c_up(tau) c_up^+(0)>, as a function of vn = i nu:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"gf", "[", "x_", "]"}], " ", "=", " ", 
       RowBox[{"Simplify", "[", RowBox[
          {RowBox[{"-", RowBox[{"correlator", "[", RowBox[
                {RowBox[{"{", RowBox[{"cup", ",", " ", "cupD"}], "}"}], ",", 
                 " ", RowBox[{"{", RowBox[{"{", RowBox[{"1", ",", " ", "0", 
                       ",", " ", "0"}], "}"}], "}"}]}], "]"}]}], " ", "/.", 
           " ", RowBox[{"vn", " ", "->", " ", "x"}]}], "]"}]}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"G = (p0 + p1)/(i nu + mu + a) + (p1 + p2)/(i nu + mu - a)\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{"gf", "[", "vn", "]"}], " ", "-", " ", RowBox[
                {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"p0", " ", "+", 
                         " ", "p1"}], ")"}], "/", RowBox[{"(", RowBox[
                        {"vn", " ", "+", " ", "mu", " ", "+", " ", "a"}], 
                       ")"}]}], " ", "+", " ", RowBox[{RowBox[{"(", RowBox[
                        {"p1", " ", "+", " ", "p2"}], ")"}], "/", RowBox[
                      {"(", RowBox[{"vn", " ", "+", " ", "mu", " ", "-", " ", 
                         "a"}], ")"}]}]}], ")"}]}], "]"}], " ", "===", " ", 
           "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[FractionBox[
     RowBox[{RowBox[{"a", " ", RowBox[{"(", RowBox[{"p0", "-", "p2"}], 
           ")"}]}], "-", RowBox[
        {RowBox[{"(", RowBox[{"p0", "+", RowBox[{"2", " ", "p1"}], "+", 
             "p2"}], ")"}], " ", RowBox[{"(", RowBox[{"mu", "+", "x"}], 
           ")"}]}]}], RowBox[
      {RowBox[{"(", RowBox[{"a", "-", "mu", "-", "x"}], ")"}], " ", 
       RowBox[{"(", RowBox[{"a", "+", "mu", "+", "x"}], ")"}]}]]], "Output"], 
  Cell[BoxData[RowBox[
     {"\"G = (p0 + p1)/(i nu + mu + a) + (p1 + p2)/(i nu + mu - a)\"", 
      "\[Rule]", "True"}]], "Output"], Cell["The generalized susceptibility \
(Thunstroem et al. 2018, Eq. 3):\nchi_ss'(nu, nu', omega) = Int dtau_1 dtau_2 \
dtau_3 e^(-i nu tau_1 + i (nu + omega) tau_2 - i (nu' + omega) tau_3) [<T \
c_s^+(tau_1) c_s(tau_2) c_s'^+(tau_3) c_s'(0)> - <T c_s^+(tau_1) c_s(tau_2)> \
<T c_s'^+(tau_3) c_s'(0)>].\nIn the disconnected part the first factor \
depends on tau_1 - tau_2 only, so the tau_2 integral gives beta delta_(omega \
0) g(nu) g(nu'), with g(nu) = Int dtau e^(-i nu tau) <T c^+(tau) c(0)>; g \
equals G:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"phisChi", " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", 
                 " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", RowBox[{"1", ",", " ", "0", ",", " ", "1"}], "}"}], 
             ",", " ", RowBox[{"{", RowBox[{"0", ",", " ", RowBox[
                  {"-", "1"}], ",", " ", RowBox[{"-", "1"}]}], "}"}]}], 
           "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"fourPoint", "[", RowBox[{"same_", ",", " ", 
             "point_"}], "]"}], " ", ":=", " ", 
         RowBox[{"correlator", "[", RowBox[{RowBox[{"If", "[", RowBox[
                {"same", ",", " ", RowBox[{"{", RowBox[{"cupD", ",", " ", 
                     "cup", ",", " ", "cupD", ",", " ", "cup"}], "}"}], ",", 
                 " ", RowBox[{"{", RowBox[{"cupD", ",", " ", "cup", ",", " ", 
                     "cdnD", ",", " ", "cdn"}], "}"}]}], "]"}], ",", " ", 
             "phisChi", ",", " ", "point"}], "]"}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"g = G\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"correlator", "[", 
                 RowBox[{RowBox[{"{", RowBox[{"cupD", ",", " ", "cup"}], 
                     "}"}], ",", " ", RowBox[{"{", RowBox[{"{", RowBox[
                        {RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "0"}], 
                       "}"}], "}"}]}], "]"}], " ", "-", " ", RowBox[
                {"gf", "[", "vn", "]"}]}], "]"}], " ", "===", " ", "0"}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"g = G\"", "\[Rule]", "True"}]], "Output"], 
  Cell["The four-point function: its generic value, and the corrections at \
the special points w = 0 (\"dk\"), vm = vn (\"dd\") and the mirror vm = -vn - \
w (\"dm\"), and at their pairwise intersections (inclusion-exclusion). For mu \
!= 0 no other nodes can coincide. Each correction multiplies a Kronecker \
delta: delta_(k 0), delta_(n n'), delta_(n', -n-k-1).", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"parts", "[", "same_", "]"}], " ", 
         ":=", " ", RowBox[{"Module", "[", RowBox[
            {RowBox[{"{", RowBox[{RowBox[{"f", " ", "=", " ", RowBox[
                    {RowBox[{"fourPoint", "[", RowBox[{"same", ",", " ", 
                         "#"}], "]"}], " ", "&"}]}], ",", " ", "gen", ",", 
                 " ", "Dk", ",", " ", "Dd", ",", " ", "Dm", ",", " ", 
                 RowBox[{"kd", " ", "=", " ", RowBox[{"{", RowBox[{"w", " ", 
                       "->", " ", "0"}], "}"}]}], ",", " ", RowBox[
                  {"dd", " ", "=", " ", RowBox[{"{", RowBox[{"vm", " ", "->", 
                       " ", "vn"}], "}"}]}], ",", " ", RowBox[{"dm", " ", 
                   "=", " ", RowBox[{"{", RowBox[{"vm", " ", "->", " ", 
                       RowBox[{RowBox[{"-", "vn"}], " ", "-", " ", "w"}]}], 
                     "}"}]}]}], "}"}], ",", "\n", "  ", 
             RowBox[{RowBox[{"gen", " ", "=", " ", RowBox[{"f", "[", 
                   RowBox[{"{", "}"}], "]"}]}], ";", "\n", "  ", RowBox[
                {"Dk", " ", "=", " ", RowBox[{"Together", "[", RowBox[
                    {RowBox[{"f", "[", "kd", "]"}], " ", "-", " ", RowBox[
                      {"(", RowBox[{"gen", " ", "/.", " ", "kd"}], ")"}]}], 
                   "]"}]}], ";", "\n", "  ", RowBox[{"Dd", " ", "=", " ", 
                 RowBox[{"Together", "[", RowBox[{RowBox[{"f", "[", "dd", 
                       "]"}], " ", "-", " ", RowBox[{"(", RowBox[{"gen", " ", 
                         "/.", " ", "dd"}], ")"}]}], "]"}]}], ";", "\n", 
               "  ", RowBox[{"Dm", " ", "=", " ", RowBox[{"Together", "[", 
                   RowBox[{RowBox[{"f", "[", "dm", "]"}], " ", "-", " ", 
                     RowBox[{"(", RowBox[{"gen", " ", "/.", " ", "dm"}], 
                       ")"}]}], "]"}]}], ";", "\n", "  ", RowBox[
                {"<|", RowBox[{RowBox[{"\"gen\"", " ", "->", " ", "gen"}], 
                   ",", " ", RowBox[{"\"dk\"", " ", "->", " ", "Dk"}], ",", 
                   " ", RowBox[{"\"dd\"", " ", "->", " ", "Dd"}], ",", " ", 
                   RowBox[{"\"dm\"", " ", "->", " ", "Dm"}], ",", "\n", 
                   "   ", RowBox[{"\"dkdd\"", " ", "->", " ", RowBox[
                      {"Together", "[", RowBox[{RowBox[{"f", "[", RowBox[
                          {"{", RowBox[{RowBox[{"w", " ", "->", " ", "0"}], 
                          ",", " ", RowBox[{"vm", " ", "->", " ", "vn"}]}], 
                          "}"}], "]"}], " ", "-", " ", RowBox[{"(", RowBox[
                          {"gen", " ", "/.", " ", RowBox[{"{", RowBox[
                          {RowBox[{"w", " ", "->", " ", "0"}], ",", " ", 
                          RowBox[{"vm", " ", "->", " ", "vn"}]}], "}"}]}], 
                          ")"}], " ", "-", " ", RowBox[{"(", RowBox[{"Dk", 
                          " ", "/.", " ", "dd"}], ")"}], " ", "-", " ", 
                         RowBox[{"(", RowBox[{"Dd", " ", "/.", " ", "kd"}], 
                          ")"}]}], "]"}]}], ",", "\n", "   ", RowBox[
                    {"\"dkdm\"", " ", "->", " ", RowBox[{"Together", "[", 
                       RowBox[{RowBox[{"f", "[", RowBox[{"{", RowBox[
                          {RowBox[{"w", " ", "->", " ", "0"}], ",", " ", 
                          RowBox[{"vm", " ", "->", " ", RowBox[{"-", 
                          "vn"}]}]}], "}"}], "]"}], " ", "-", " ", RowBox[
                          {"(", RowBox[{"gen", " ", "/.", " ", RowBox[{"{", 
                          RowBox[{RowBox[{"w", " ", "->", " ", "0"}], ",", 
                          " ", RowBox[{"vm", " ", "->", " ", RowBox[{"-", 
                          "vn"}]}]}], "}"}]}], ")"}], " ", "-", " ", RowBox[
                          {"(", RowBox[{"Dk", " ", "/.", " ", RowBox[{"vm", 
                          " ", "->", " ", RowBox[{"-", "vn"}]}]}], ")"}], 
                         " ", "-", " ", RowBox[{"(", RowBox[{"Dm", " ", "/.", 
                          " ", "kd"}], ")"}]}], "]"}]}], ",", "\n", "   ", 
                   RowBox[{"\"dddm\"", " ", "->", " ", RowBox[{"Together", 
                       "[", RowBox[{RowBox[{"f", "[", RowBox[{"{", RowBox[
                          {RowBox[{"vm", " ", "->", " ", "vn"}], ",", " ", 
                          RowBox[{"w", " ", "->", " ", RowBox[{RowBox[{"-", 
                          "2"}], " ", "vn"}]}]}], "}"}], "]"}], " ", "-", 
                         " ", RowBox[{"(", RowBox[{"gen", " ", "/.", " ", 
                          RowBox[{"{", RowBox[{RowBox[{"vm", " ", "->", " ", 
                          "vn"}], ",", " ", RowBox[{"w", " ", "->", " ", 
                          RowBox[{RowBox[{"-", "2"}], " ", "vn"}]}]}], 
                          "}"}]}], ")"}], " ", "-", " ", RowBox[{"(", RowBox[
                          {"Dd", " ", "/.", " ", RowBox[{"w", " ", "->", " ", 
                          RowBox[{RowBox[{"-", "2"}], " ", "vn"}]}]}], ")"}], 
                         " ", "-", " ", RowBox[{"(", RowBox[{"Dm", " ", "/.", 
                          " ", RowBox[{"{", RowBox[{RowBox[{"vm", " ", "->", 
                          " ", "vn"}], ",", " ", RowBox[{"w", " ", "->", " ", 
                          RowBox[{RowBox[{"-", "2"}], " ", "vn"}]}]}], 
                          "}"}]}], ")"}]}], "]"}]}]}], "|>"}]}]}], "]"}]}], 
       ";"}], "\n", RowBox[{RowBox[{"uu", " ", "=", " ", 
         RowBox[{"parts", "[", "True", "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"ud", " ", "=", " ", RowBox[{"parts", "[", "False", 
           "]"}]}], ";"}], "\n", RowBox[{"check", "[", 
       RowBox[{"\"no mirror correction and no corrections at intersections \
(mu generic)\"", ",", " ", RowBox[{RowBox[{"Union", "[", 
             RowBox[{"Flatten", "[", RowBox[{"Values", " ", "/@", " ", 
                 RowBox[{"{", RowBox[{RowBox[{"KeyTake", "[", RowBox[
                        {"uu", ",", " ", RowBox[{"{", RowBox[{"\"dm\"", ",", 
                          " ", "\"dkdd\"", ",", " ", "\"dkdm\"", ",", " ", 
                          "\"dddm\""}], "}"}]}], "]"}], ",", " ", RowBox[
                      {"KeyTake", "[", RowBox[{"ud", ",", " ", RowBox[
                          {"{", RowBox[{"\"dm\"", ",", " ", "\"dkdd\"", ",", 
                          " ", "\"dkdm\"", ",", " ", "\"dddm\""}], "}"}]}], 
                       "]"}]}], "}"}]}], "]"}], "]"}], " ", "===", " ", 
           RowBox[{"{", "0", "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[
     {"\"no mirror correction and no corrections at intersections (mu \
generic)\"", "\[Rule]", "True"}]], "Output"], Cell["So chi_ss' = gen + \
delta_(k0) (dk - beta G(nu) G(nu')) + delta_(nn') dd, with no further terms. \
The weights are normalized from now on, and rho = p2 - p0 = <n> - 1.", 
   "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"norm", " ", "=", " ", 
         RowBox[{"{", RowBox[{"p1", " ", "->", " ", 
             RowBox[{RowBox[{"(", RowBox[{"1", " ", "-", " ", "p0", " ", "-", 
                   " ", "p2"}], ")"}], "/", "2"}]}], "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"rho", " ", "=", " ", RowBox[{"p2", " ", "-", " ", 
           "p0"}]}], ";"}]}], "Input"], 
  Cell["2 The input in the variables of the note", "Section"], 
  Cell["2.1 Comparison with Ref. [Essl et al. 2024, Eq. (D3)] as written in \
the note", "Subsection"], Cell["Eqs. (chi-uu), (chi-ud) of the note, with x_n \
= mu + i nu_n, J(x) = 1/(x^2 - a^2), and the generic part N_nm in the compact \
form of Lemma \"compact input\": centered variables z = x_n + w/2, v = x_m + \
w/2, Q_+-(z) = (z +- a)^2 - w^2/4, q0 = a^2 - w^2/4, Cauchy entry C = rho/(z \
+ v) (mu != 0).", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"J", "[", "x_", "]"}], " ", ":=", 
         " ", RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[{"x", "^", "2"}], 
               " ", "-", " ", RowBox[{"a", "^", "2"}]}], ")"}]}]}], ";"}], 
     "\n", RowBox[{RowBox[{RowBox[{"Qp", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{"(", RowBox[{"x", " ", "+", " ", "a"}], 
               ")"}], "^", "2"}], " ", "-", " ", 
           RowBox[{RowBox[{"w", "^", "2"}], "/", "4"}]}]}], ";", " ", 
       RowBox[{RowBox[{"Qm", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{"(", RowBox[{"x", " ", "-", " ", "a"}], 
               ")"}], "^", "2"}], " ", "-", " ", 
           RowBox[{RowBox[{"w", "^", "2"}], "/", "4"}]}]}], ";", " ", 
       RowBox[{RowBox[{"P", "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{"Qp", "[", "x", "]"}], " ", 
           RowBox[{"Qm", "[", "x", "]"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"q0", " ", "=", " ", RowBox[{RowBox[{"a", "^", "2"}], 
           " ", "-", " ", RowBox[{RowBox[{"w", "^", "2"}], "/", "4"}]}]}], 
       ";"}], "\n", RowBox[{RowBox[{"toZ", " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"vn", " ", "->", " ", RowBox[
                {"z", " ", "-", " ", "mu", " ", "-", " ", RowBox[{"w", "/", 
                   "2"}]}]}], ",", " ", RowBox[{"vm", " ", "->", " ", RowBox[
                {"v", " ", "-", " ", "mu", " ", "-", " ", RowBox[{"w", "/", 
                   "2"}]}]}]}], "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"NnoteCompact", " ", "=", " ", 
         RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"4", " ", RowBox[
                    {"a", "^", "2"}], " ", RowBox[{"rho", "/", RowBox[
                      {"(", RowBox[{"z", " ", "+", " ", "v"}], ")"}]}]}], 
                 " ", "-", " ", RowBox[{"2", " ", "a"}]}], ")"}], "/", 
             RowBox[{"(", RowBox[{RowBox[{"Qm", "[", "z", "]"}], " ", 
                 RowBox[{"Qm", "[", "v", "]"}]}], ")"}]}], " ", "+", " ", 
           RowBox[{"4", " ", RowBox[{"a", "^", "2"}], " ", 
             RowBox[{"(", RowBox[{"1", " ", "-", " ", "rho"}], ")"}], " ", 
             RowBox[{"(", RowBox[{"z", " ", "+", " ", "v", " ", "+", " ", 
                 RowBox[{"2", " ", "a"}]}], ")"}], " ", 
             RowBox[{RowBox[{"(", RowBox[{RowBox[{"z", " ", "v"}], " ", "+", 
                   " ", "q0"}], ")"}], "/", RowBox[{"(", RowBox[
                  {RowBox[{"P", "[", "z", "]"}], " ", RowBox[{"P", "[", "v", 
                     "]"}]}], ")"}]}]}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"xn", " ", "=", " ", RowBox[{"mu", " ", "+", " ", 
           "vn"}]}], ";", " ", RowBox[{"xm", " ", "=", " ", 
         RowBox[{"mu", " ", "+", " ", "vm"}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"Eq. (chi-uu): generic, delta_k0, delta_nn' parts\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"{", RowBox[
                  {RowBox[{"uu", "[", "\"gen\"", "]"}], ",", "\n", "     ", 
                   RowBox[{RowBox[{"uu", "[", "\"dk\"", "]"}], " ", "-", " ", 
                     RowBox[{"beta", " ", RowBox[{"gf", "[", "vn", "]"}], 
                       " ", RowBox[{"gf", "[", "vm", "]"}]}], " ", "-", " ", 
                     RowBox[{"beta", " ", RowBox[{"a", "^", "2"}], " ", 
                       RowBox[{"(", RowBox[{"1", " ", "-", " ", RowBox[
                          {"rho", "^", "2"}]}], ")"}], " ", RowBox[{"J", "[", 
                         "xn", "]"}], " ", RowBox[{"J", "[", "xm", "]"}]}]}], 
                   ",", "\n", "     ", RowBox[{RowBox[{"uu", "[", "\"dd\"", 
                       "]"}], " ", "-", " ", RowBox[{"(", RowBox[
                        {RowBox[{RowBox[{"-", "beta"}], " ", RowBox[{"gf", 
                          "[", RowBox[{"xn", " ", "-", " ", "mu"}], "]"}], 
                          " ", RowBox[{"gf", "[", RowBox[{"xn", " ", "-", 
                          " ", "mu", " ", "+", " ", "w"}], "]"}]}], " ", "-", 
                         " ", RowBox[{"beta", " ", RowBox[{"a", "^", "2"}], 
                          " ", RowBox[{"(", RowBox[{"1", " ", "-", " ", 
                          RowBox[{"rho", "^", "2"}]}], ")"}], " ", RowBox[
                          {"J", "[", RowBox[{"xn", " ", "+", " ", "w"}], 
                          "]"}], " ", RowBox[{"J", "[", "xn", "]"}]}]}], 
                       ")"}]}]}], "}"}], " ", "/.", " ", "norm"}], "]"}], 
           " ", "===", " ", RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", 
               " ", "0"}], "}"}]}]}], "]"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"Eq. (chi-ud) and Lemma compact input\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"{", RowBox[
                  {RowBox[{RowBox[{"ud", "[", "\"dk\"", "]"}], " ", "-", " ", 
                     RowBox[{"beta", " ", RowBox[{"gf", "[", "vn", "]"}], 
                       " ", RowBox[{"gf", "[", "vm", "]"}]}], " ", "-", " ", 
                     RowBox[{"4", " ", "beta", " ", RowBox[{"a", "^", "2"}], 
                       " ", RowBox[{"(", RowBox[{RowBox[{"p0", " ", "p2"}], 
                          " ", "-", " ", RowBox[{"p1", "^", "2"}]}], ")"}], 
                       " ", RowBox[{"J", "[", "xn", "]"}], " ", RowBox[
                        {"J", "[", "xm", "]"}]}]}], ",", "\n", "     ", 
                   RowBox[{RowBox[{"ud", "[", "\"dd\"", "]"}], " ", "+", " ", 
                     RowBox[{"4", " ", "beta", " ", RowBox[{"a", "^", "2"}], 
                       " ", "p1", " ", RowBox[{"J", "[", "xn", "]"}], " ", 
                       RowBox[{"J", "[", RowBox[{"xn", " ", "+", " ", "w"}], 
                         "]"}]}]}], ",", "\n", "     ", RowBox[
                    {RowBox[{"(", RowBox[{RowBox[{"ud", "[", "\"gen\"", 
                          "]"}], " ", "/.", " ", "toZ"}], ")"}], " ", "-", 
                     " ", "NnoteCompact"}]}], "}"}], " ", "/.", " ", 
               "norm"}], "]"}], " ", "===", " ", 
           RowBox[{"{", RowBox[{"0", ",", " ", "0", ",", " ", "0"}], 
             "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[
     {"\"Eq. (chi-uu): generic, delta_k0, delta_nn' parts\"", "\[Rule]", 
      "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"Eq. (chi-ud) and Lemma compact input\"", "\[Rule]", 
      "True"}]], "Output"], 
  Cell["2.2 Density and magnetic channels: Proposition \"structure\"", 
   "Subsection"], Cell["chi_r = chi_upup + eps chi_updn with eps = +1 (d), -1 \
(m), as functions of the centered points z = z_n, v = z_m. All parts share \
the denominator P(z) = Q_+(z) Q_-(z), even in z, with no zeros on the \
lattice:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"chiR", "[", "eps_", "]"}], " ", 
         ":=", " ", RowBox[{RowBox[{"chiR", "[", "eps", "]"}], " ", "=", " ", 
           RowBox[{"Map", "[", RowBox[{RowBox[{RowBox[{"Simplify", "[", 
                   RowBox[{RowBox[{"#", " ", "/.", " ", "toZ"}], " ", "/.", 
                     " ", "norm"}], "]"}], " ", "&"}], ",", " ", RowBox[
                {"<|", RowBox[{RowBox[{"\"gen\"", " ", "->", " ", RowBox[
                      {RowBox[{"uu", "[", "\"gen\"", "]"}], " ", "+", " ", 
                       RowBox[{"eps", " ", RowBox[{"ud", "[", "\"gen\"", 
                          "]"}]}]}]}], ",", "\n", "     ", RowBox[{"\"dk\"", 
                     " ", "->", " ", RowBox[{RowBox[{"uu", "[", "\"dk\"", 
                         "]"}], " ", "+", " ", RowBox[{"eps", " ", RowBox[
                          {"ud", "[", "\"dk\"", "]"}]}], " ", "-", " ", 
                       RowBox[{RowBox[{"(", RowBox[{"1", " ", "+", " ", 
                          "eps"}], ")"}], " ", "beta", " ", RowBox[{"gf", 
                          "[", "vn", "]"}], " ", RowBox[{"gf", "[", "vm", 
                          "]"}]}]}]}], ",", " ", RowBox[{"\"dd\"", " ", "->", 
                     " ", RowBox[{"(", RowBox[{RowBox[{RowBox[{"uu", "[", 
                          "\"dd\"", "]"}], " ", "+", " ", RowBox[{"eps", " ", 
                          RowBox[{"ud", "[", "\"dd\"", "]"}]}]}], " ", "/.", 
                         " ", RowBox[{"vm", " ", "->", " ", "vn"}]}], 
                       ")"}]}]}], "|>"}]}], "]"}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"(x_n - a)(x_n + w - a) = Q_-(z_n), (x_n \
+ a)(x_n + w + a) = Q_+(z_n), P even\"", ",", " ", 
         RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                {RowBox[{"{", RowBox[{RowBox[{RowBox[{RowBox[{"(", RowBox[
                          {"xn", " ", "-", " ", "a"}], ")"}], " ", RowBox[
                          {"(", RowBox[{"xn", " ", "+", " ", "w", " ", "-", 
                          " ", "a"}], ")"}]}], " ", "-", " ", RowBox[
                        {"Qm", "[", "z", "]"}]}], ",", " ", RowBox[
                      {RowBox[{RowBox[{"(", RowBox[{"xn", " ", "+", " ", 
                          "a"}], ")"}], " ", RowBox[{"(", RowBox[{"xn", " ", 
                          "+", " ", "w", " ", "+", " ", "a"}], ")"}]}], " ", 
                       "-", " ", RowBox[{"Qp", "[", "z", "]"}]}]}], "}"}], 
                 " ", "/.", " ", RowBox[{"vn", " ", "->", " ", RowBox[
                    {"z", " ", "-", " ", "mu", " ", "-", " ", RowBox[
                      {"w", "/", "2"}]}]}]}], "]"}], " ", "===", " ", 
             RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}], " ", "&&", 
           " ", RowBox[{RowBox[{"Expand", "[", RowBox[{RowBox[{"P", "[", "z", 
                   "]"}], " ", "-", " ", RowBox[{"P", "[", RowBox[
                    {"-", "z"}], "]"}]}], "]"}], " ", "===", " ", "0"}]}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"(x_n - a)(x_n + w - a) = Q_-(z_n), (x_n + a)(x_n + \
w + a) = Q_+(z_n), P even\"", "\[Rule]", "True"}]], "Output"], 
  Cell["Extract, for each channel: the diagonal function H from P(z) chi_dd = \
-beta H(z); the Cauchy coefficient lambda from the residue of P(z) chi_gen at \
z = -v (it multiplies rho/(z + v)); and the remaining numerator N(z, v) = \
P(z) P(v) [chi_gen - lambda rho/((z + v) P(z))], plus the static (k = 0, w = \
0) part P(z) P(v) chi_dk.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"Hx", "[", "eps_", "]"}], " ", ":=", 
         " ", RowBox[{RowBox[{"Hx", "[", "eps", "]"}], " ", "=", " ", 
           RowBox[{"Factor", "[", RowBox[{RowBox[{"-", RowBox[{"P", "[", "z", 
                   "]"}]}], " ", RowBox[{RowBox[{RowBox[{"chiR", "[", "eps", 
                     "]"}], "[", "\"dd\"", "]"}], "/", "beta"}]}], "]"}]}]}], 
       ";"}], "\n", RowBox[{RowBox[{RowBox[{"lam", "[", "eps_", "]"}], " ", 
         ":=", " ", RowBox[{RowBox[{"lam", "[", "eps", "]"}], " ", "=", " ", 
           RowBox[{"Simplify", "[", RowBox[{RowBox[{"(", RowBox[
                  {RowBox[{"Together", "[", RowBox[{RowBox[{"(", RowBox[
                          {"z", " ", "+", " ", "v"}], ")"}], " ", RowBox[
                        {"P", "[", "z", "]"}], " ", RowBox[{RowBox[{"chiR", 
                          "[", "eps", "]"}], "[", "\"gen\"", "]"}]}], "]"}], 
                   " ", "/.", " ", RowBox[{"z", " ", "->", " ", RowBox[
                      {"-", "v"}]}]}], ")"}], "/", "rho"}], "]"}]}]}], ";"}], 
     "\n", RowBox[{RowBox[{RowBox[{"Ngen", "[", "eps_", "]"}], " ", ":=", 
         " ", RowBox[{RowBox[{"Ngen", "[", "eps", "]"}], " ", "=", " ", 
           RowBox[{"Expand", "[", RowBox[{"Simplify", "[", RowBox[
