                          "st"}], "]"}], "[", RowBox[{"z", ",", " ", RowBox[
                          {"u", "^", "2"}]}], "]"}], "/", RowBox[{"(", 
                          RowBox[{"rho", " ", RowBox[{RowBox[{"Pf", "[", 
