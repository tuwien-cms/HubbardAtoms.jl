                          " ", RowBox[{"{", RowBox[{"t", ",", " ", "y"}], 
                          "}"}]}], "]"}], " ", RowBox[{"tAt", "[", "y", 
                         "]"}]}], ",", " ", RowBox[{"{", RowBox[{"y", ",", 
                         " ", "poles"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
       "\n", RowBox[{"(*", " ", RowBox[
          {RowBox[{RowBox[{"numerical", " ", "test", " ", "of", " ", RowBox[
                {"T_k", ":", " ", "k"}]}], " ", "=", " ", "3"}], ",", " ", 
           RowBox[{"U", " ", "=", " ", "2"}], ",", " ", 
           RowBox[{"beta", " ", "=", " ", "3"}], ",", " ", 
           RowBox[{"mu", " ", "=", " ", "0.3"}]}], " ", "*)"}]}], "\n", 
     RowBox[{"Module", "[", RowBox[
        {RowBox[{"{", RowBox[{RowBox[{"k", " ", "=", " ", "3"}], ",", " ", 
             RowBox[{"nums", " ", "=", " ", RowBox[{"{", RowBox[
                  {RowBox[{"a", " ", "->", " ", "1"}], ",", " ", RowBox[
                    {"beta", " ", "->", " ", "3"}], ",", " ", RowBox[
                    {"mu", " ", "->", " ", RowBox[{"3", "/", "10"}]}]}], 
                 "}"}]}], ",", " ", RowBox[{"t0", " ", "=", " ", RowBox[
                {RowBox[{"1", "/", "2"}], " ", "+", " ", RowBox[{"I", "/", 
                   "3"}]}]}], ",", " ", "tl", ",", " ", "xi0"}], "}"}], ",", 
         "\n", " ", RowBox[{RowBox[{RowBox[{"tl", "[", "n_", "]"}], " ", 
             ":=", " ", RowBox[{RowBox[{"Module", "[", RowBox[
                  {RowBox[{"{", RowBox[{"x", " ", "=", " ", RowBox[{"mu", 
                         " ", "+", " ", RowBox[{"I", " ", "Pi", " ", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"2", " ", "n"}], " ", 
                          "+", " ", "1"}], ")"}], "/", "beta"}]}]}]}], "}"}], 
                   ",", " ", RowBox[{"x", " ", RowBox[{"(", RowBox[
                        {RowBox[{"2", " ", "mu"}], " ", "-", " ", RowBox[
                          {"2", " ", "Pi", " ", "I", " ", RowBox[{"k", "/", 
                          "beta"}]}], " ", "-", " ", "x"}], ")"}]}]}], "]"}], 
               " ", "/.", " ", "nums"}]}], ";", "\n", " ", 
           RowBox[{"xi0", " ", "=", " ", RowBox[{RowBox[{"Sqrt", "[", 
                 RowBox[{RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"2", 
                          " ", "mu"}], " ", "-", " ", RowBox[{"2", " ", "Pi", 
                          " ", "I", " ", RowBox[{"k", "/", "beta"}]}]}], 
                         ")"}], "^", "2"}], "/", "4"}], " ", "-", " ", 
                   "t0"}], "]"}], " ", "/.", " ", "nums"}]}], ";", "\n", " ", 
           RowBox[{"(*", " ", RowBox[{RowBox[{RowBox[{"the", " ", "tail", 
                   " ", "of", " ", "the", " ", "sum", " ", "beyond"}], " ", 
                 "|", "n", "|"}], " ", "=", " ", RowBox[{"N", " ", "is", " ", 
                 "O", RowBox[{"(", RowBox[{"1", "/", "N"}], ")"}]}]}], " ", 
             "*)"}], "\n", " ", RowBox[{"check", "[", 
             RowBox[{"\"T_k vs direct sum\"", ",", " ", RowBox[
                {RowBox[{"Abs", "[", RowBox[{RowBox[{"N", "[", RowBox[
                        {"Sum", "[", RowBox[{RowBox[{"1", "/", RowBox[{"(", 
                          RowBox[{RowBox[{"tl", "[", "n", "]"}], " ", "-", 
                          " ", "t0"}], ")"}]}], ",", " ", RowBox[{"{", 
                          RowBox[{"n", ",", " ", RowBox[{"-", "20000"}], ",", 
                          " ", "19999"}], "}"}]}], "]"}], "]"}], " ", "-", 
                     " ", RowBox[{"N", "[", RowBox[{RowBox[{RowBox[{"-", 
                          RowBox[{RowBox[{"Sk", "[", "1", "]"}], "[", RowBox[
                          {"mu", " ", "+", " ", "xi0"}], "]"}]}], "/", 
                          "xi0"}], " ", "/.", " ", "nums"}], "]"}]}], "]"}], 
                 " ", "<", " ", RowBox[{"10", "^", RowBox[{"-", "4"}]}]}]}], 
             "]"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"xi at t+-\"", "\[Rule]", "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"T_k vs direct sum\"", "\[Rule]", "True"}]], 
   "Output"], Cell["4.2 Triplet", "Subsection"], 
  Cell["On an orbit {n, nbar} with n != nbar, chi_t is the 2x2 block with \
diagonal (B + L_t)/2 and off-diagonal (B - L_t)/2 (Section 2.3), and bold B \
is B times the identity. Gamma_t = beta^2 (chi_t^-1 - B^-1) on the block:", 
   "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"GtBlock", " ", "=", " ", 
         RowBox[{"Simplify", "[", RowBox[{RowBox[{"beta", "^", "2"}], " ", 
             RowBox[{"(", RowBox[{RowBox[{"Inverse", "[", RowBox[
                    {RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[
                          {"BppT", " ", "+", " ", "LtT"}], ",", " ", RowBox[
                          {"BppT", " ", "-", " ", "LtT"}]}], "}"}], ",", " ", 
                         RowBox[{"{", RowBox[{RowBox[{"BppT", " ", "-", " ", 
                          "LtT"}], ",", " ", RowBox[{"BppT", " ", "+", " ", 
                          "LtT"}]}], "}"}]}], "}"}], "/", "2"}], "]"}], " ", 
                 "-", " ", RowBox[{RowBox[{"IdentityMatrix", "[", "2", "]"}], 
                   "/", "BppT"}]}], ")"}]}], "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"GtNote", " ", "=", " ", RowBox[{"beta", " ", 
           RowBox[{"a", "^", "2"}], " ", RowBox[
            {"(", RowBox[{"1", " ", "-", " ", RowBox[{"rho", "^", "2"}]}], 
             ")"}], " ", RowBox[{RowBox[{"PPt", "[", "t", "]"}], "/", 
             RowBox[{"(", RowBox[{RowBox[{"GGt", "[", "t", "]"}], " ", 
                 RowBox[{"(", RowBox[{"t", " ", "+", " ", RowBox[{"a", " ", 
                       "rho", " ", "bb"}], " ", "+", " ", RowBox[{"a", "^", 
                       "2"}]}], ")"}]}], ")"}]}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"Theorem triplet\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"GtBlock", " ", 
                 "-", " ", RowBox[{"GtNote", " ", RowBox[{"{", RowBox[
                      {RowBox[{"{", RowBox[{"1", ",", " ", RowBox[{"-", 
                          "1"}]}], "}"}], ",", " ", RowBox[{"{", RowBox[
                          {RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], 
                     "}"}]}]}], " ", "/.", " ", "norm"}], "]"}], " ", "===", 
           " ", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", 
                   "0"}], "}"}], ",", " ", RowBox[{"{", RowBox[{"0", ",", 
                   " ", "0"}], "}"}]}], "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"Theorem triplet\"", "\[Rule]", "True"}]], 
   "Output"], Cell["At a fixed point n = nbar the orbit has one element, \
chi_t,nn = (B + L_t)/2 + (B - L_t)/2 = B, and Gamma_t,nn = 0.", "Text"], 
  Cell["4.3 Singlet", "Subsection"], Cell["chi_s = X + g gamma g^T with X = \
L_s M_+ - B M_-. The rank-two part: partial fractions of chi_s,reg (Section \
2.3) in t_n and t_m give gamma_+- (the coefficients of g_+-(t_n) g_+-(t_m), \
g_+-(t) = 1/(t - t+-)), with no cross terms:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"gp", "[", "t_", "]"}], " ", ":=", 
         " ", RowBox[{"1", "/", RowBox[{"(", RowBox[{"t", " ", "-", " ", 
               "tp"}], ")"}]}]}], ";", " ", 
       RowBox[{RowBox[{"gm", "[", "t_", "]"}], " ", ":=", " ", 
         RowBox[{"1", "/", RowBox[{"(", RowBox[{"t", " ", "-", " ", "tm"}], 
             ")"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"{", RowBox[{"gamPlus", ",", " ", "gamMinus"}], "}"}], 
       " ", "=", " ", RowBox[{"Simplify", "[", 
         RowBox[{RowBox[{"{", RowBox[{RowBox[{RowBox[{"Together", "[", 
                   RowBox[{RowBox[{"(", RowBox[{"tn", " ", "-", " ", "tp"}], 
                       ")"}], " ", RowBox[{"(", RowBox[{"tmm", " ", "-", " ", 
                         "tp"}], ")"}], " ", "chiSregT"}], "]"}], " ", "/.", 
                 " ", RowBox[{"{", RowBox[{RowBox[{"tn", " ", "->", " ", 
                       "tp"}], ",", " ", RowBox[{"tmm", " ", "->", " ", 
                       "tp"}]}], "}"}]}], ",", " ", RowBox[
                {RowBox[{"Together", "[", RowBox[{RowBox[{"(", RowBox[
                        {"tn", " ", "-", " ", "tm"}], ")"}], " ", RowBox[
                      {"(", RowBox[{"tmm", " ", "-", " ", "tm"}], ")"}], " ", 
                     "chiSregT"}], "]"}], " ", "/.", " ", RowBox[
                  {"{", RowBox[{RowBox[{"tn", " ", "->", " ", "tm"}], ",", 
                     " ", RowBox[{"tmm", " ", "->", " ", "tm"}]}], "}"}]}]}], 
             "}"}], " ", "/.", " ", "norm"}], "]"}]}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"chi_s,reg = gamma_+ g_+ g_+ + gamma_- g_- g_- (Eq. chi-s-reg)\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{"chiSregT", " ", "-", " ", RowBox[{"gamPlus", 
                   " ", RowBox[{"gp", "[", "tn", "]"}], " ", RowBox[
                    {"gp", "[", "tmm", "]"}]}], " ", "-", " ", RowBox[
                  {"gamMinus", " ", RowBox[{"gm", "[", "tn", "]"}], " ", 
                   RowBox[{"gm", "[", "tmm", "]"}]}]}], " ", "/.", " ", 
               "norm"}], "]"}], " ", "===", " ", "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"-", FractionBox[RowBox[{"a", " ", 
             RowBox[{"(", RowBox[{RowBox[{"-", "1"}], "+", "p0", "-", "p2"}], 
               ")"}], " ", RowBox[{"(", RowBox[{RowBox[{"2", " ", "a"}], "-", 
                 RowBox[{"2", " ", "mu"}], "+", "wpp"}], ")"}]}], 
           RowBox[{RowBox[{"4", " ", "mu"}], "-", RowBox[{"2", " ", 
               "wpp"}]}]]}], ",", RowBox[{"-", FractionBox[
           RowBox[{"a", " ", RowBox[{"(", RowBox[{"1", "+", "p0", "-", 
                 "p2"}], ")"}], " ", RowBox[{"(", RowBox[
                {RowBox[{"2", " ", "a"}], "+", RowBox[{"2", " ", "mu"}], "-", 
                 "wpp"}], ")"}]}], RowBox[{RowBox[{"4", " ", "mu"}], "-", 
             RowBox[{"2", " ", "wpp"}]}]]}]}], "}"}]], "Output"], 
  Cell[BoxData[RowBox[
     {"\"chi_s,reg = gamma_+ g_+ g_+ + gamma_- g_- g_- (Eq. chi-s-reg)\"", 
      "\[Rule]", "True"}]], "Output"], Cell["Woodbury: X^-1 = L_s^-1 M_+ - \
B^-1 M_- and M_+ g = g, so V = X^-1 g has rows g(t_n)/L_s(t_n), and Psi = g^T \
V = Sum_n g(t_n) g(t_n)^T / L_s(t_n). Its entries are proper rational \
functions of t_n with simple poles at t+, t-, -As, summed by T_k:", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{RowBox[{"gvec", "[", "t_", "]"}], " ", ":=", 
         " ", RowBox[{"{", RowBox[{RowBox[{"gp", "[", "t", "]"}], ",", " ", 
             RowBox[{"gm", "[", "t", "]"}]}], "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{"Psi", " ", "=", " ", RowBox[{"Table", "[", 
           RowBox[{RowBox[{"tsum", "[", RowBox[{RowBox[{RowBox[
                    {RowBox[{"gvec", "[", "t", "]"}], "[", RowBox[{"[", "i", 
                       "]"}], "]"}], " ", RowBox[{RowBox[{RowBox[{"gvec", 
                         "[", "t", "]"}], "[", RowBox[{"[", "j", "]"}], 
                       "]"}], "/", "LsT"}]}], ",", " ", "t"}], "]"}], ",", 
             " ", RowBox[{"{", RowBox[{"i", ",", " ", "2"}], "}"}], ",", " ", 
             RowBox[{"{", RowBox[{"j", ",", " ", "2"}], "}"}]}], "]"}]}], 
       ";"}], "\n", RowBox[{RowBox[{"Vn", " ", "=", " ", 
         RowBox[{RowBox[{"gvec", "[", "tn", "]"}], "/", 
           RowBox[{"(", RowBox[{"LsT", " ", "/.", " ", RowBox[{"t", " ", 
                 "->", " ", "tn"}]}], ")"}]}]}], ";", " ", 
       RowBox[{"Vm", " ", "=", " ", RowBox[{RowBox[{"gvec", "[", "tmm", 
             "]"}], "/", RowBox[{"(", RowBox[{"LsT", " ", "/.", " ", RowBox[
                {"t", " ", "->", " ", "tmm"}]}], ")"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"GsDiag", " ", "=", " ", RowBox[{"Simplify", "[", 
           RowBox[{RowBox[{"beta", "^", "2"}], " ", 
             RowBox[{RowBox[{"(", RowBox[{RowBox[{"1", "/", "LsT"}], " ", 
                   "+", " ", RowBox[{"1", "/", "BppT"}]}], ")"}], "/", 
               "2"}]}], "]"}]}], ";"}]}], "Input"], 
  Cell["The diagonal part of Gamma_s = beta^2 (chi_s^-1 + B^-1) on an orbit \
is beta^2 (1/L_s + 1/B) M_+, i.e. GsDiag (delta_nm + delta_(m nbar)). The \
theorem (K_s = 1 + 2a Ts/beta):", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"Ks", " ", "=", " ", 
         RowBox[{"1", " ", "+", " ", RowBox[{"2", " ", "a", " ", 
             RowBox[{"Ts", "/", "beta"}]}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"Theorem singlet, diagonal/mirror part\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"GsDiag", " ", "-", 
                 " ", RowBox[{"beta", " ", RowBox[{"a", "^", "2"}], " ", 
                   RowBox[{"(", RowBox[{RowBox[{"rho", "^", "2"}], " ", "-", 
                       " ", "1", " ", "+", " ", RowBox[{"8", " ", "p1"}]}], 
                     ")"}], " ", RowBox[{RowBox[{"PPt", "[", "t", "]"}], "/", 
                     RowBox[{"(", RowBox[{RowBox[{"GGt", "[", "t", "]"}], 
                         " ", RowBox[{"(", RowBox[{"t", " ", "+", " ", 
                          "As"}], ")"}]}], ")"}]}]}]}], " ", "/.", " ", 
               "norm"}], "]"}], " ", "===", " ", "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"Theorem singlet, diagonal/mirror part\"", 
      "\[Rule]", "True"}]], "Output"], Cell["The separable part -beta^2 V \
(gamma^-1 + Psi)^-1 V^T. Change of basis (note, proof of Theorem \
\"singlet\"): with kappa_n = 1/(t_n + As) and d+- = As + t+-, the rows of V \
are (2/beta) Theta^T (1, kappa_n), and Xi = Theta^-T (gamma^-1 + Psi) \
Theta^-1 is diagonal (identity A4):", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"dp", " ", "=", " ", 
         RowBox[{"As", " ", "+", " ", "tp"}]}], ";", " ", 
       RowBox[{"dm", " ", "=", " ", RowBox[{"As", " ", "+", " ", "tm"}]}], 
       ";"}], "\n", RowBox[{RowBox[{"Theta", " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", " ", "1"}], 
               "}"}], ",", " ", RowBox[{"{", RowBox[{RowBox[{"-", "dm"}], 
                 ",", " ", RowBox[{"-", "dp"}]}], "}"}]}], "}"}]}], ";"}], 
     "\n", RowBox[{RowBox[{RowBox[{"kap", "[", "t_", "]"}], " ", ":=", " ", 
         RowBox[{"1", "/", RowBox[{"(", RowBox[{"t", " ", "+", " ", "As"}], 
             ")"}]}]}], ";"}], "\n", RowBox[{"check", "[", 
       RowBox[{"\"V_n = (2/beta) Theta^T (1, kappa_n)\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"(", RowBox[
                  {"Vn", " ", "-", " ", RowBox[{RowBox[{"2", "/", "beta"}], 
                     " ", RowBox[{RowBox[{"Transpose", "[", "Theta", "]"}], 
                       " ", ".", " ", RowBox[{"{", RowBox[{"1", ",", " ", 
                          RowBox[{"kap", "[", "tn", "]"}]}], "}"}]}]}]}], 
                 ")"}], " ", "/.", " ", "norm"}], "]"}], " ", "===", " ", 
           RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}]}], "]"}], "\n", 
     RowBox[{RowBox[{"Xi", " ", "=", " ", 
         RowBox[{RowBox[{"Transpose", "[", RowBox[{"Inverse", "[", "Theta", 
               "]"}], "]"}], " ", ".", " ", RowBox[
            {"(", RowBox[{RowBox[{"Inverse", "[", RowBox[{"DiagonalMatrix", 
                   "[", RowBox[{"{", RowBox[{"gamPlus", ",", " ", 
                       "gamMinus"}], "}"}], "]"}], "]"}], " ", "+", " ", 
               "Psi"}], ")"}], " ", ".", " ", RowBox[{"Inverse", "[", 
             "Theta", "]"}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"Xi = diag(-1/a, K_s/(a d+ d-)) (A4)\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{RowBox[{"(", RowBox[{"Xi", " ", "-", " ", 
                     RowBox[{"DiagonalMatrix", "[", RowBox[{"{", RowBox[
                          {RowBox[{RowBox[{"-", "1"}], "/", "a"}], ",", " ", 
                          RowBox[{"Ks", "/", RowBox[{"(", RowBox[{"a", " ", 
                          "dp", " ", "dm"}], ")"}]}]}], "}"}], "]"}]}], 
                   ")"}], " ", "/.", " ", RowBox[{"Splus", " ", "->", " ", 
                   RowBox[{"(", RowBox[{"Splus", " ", "/.", " ", "norm"}], 
                     ")"}]}]}], " ", "/.", " ", "norm"}], "]"}], " ", "===", 
           " ", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", 
                   "0"}], "}"}], ",", " ", RowBox[{"{", RowBox[{"0", ",", 
                   " ", "0"}], "}"}]}], "}"}]}]}], "]"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"d+ d- = P(-As)\"", ",", " ", 
         RowBox[{RowBox[{"Simplify", "[", RowBox[{RowBox[{"dp", " ", "dm"}], 
               " ", "-", " ", RowBox[{"PPt", "[", RowBox[{"-", "As"}], 
                 "]"}]}], "]"}], " ", "===", " ", "0"}]}], "]"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"Theorem singlet, separable part\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{RowBox[{"-", RowBox[{"beta", "^", "2"}]}], " ", 
                 RowBox[{RowBox[{"(", RowBox[{"2", "/", "beta"}], ")"}], "^", 
                   "2"}], " ", RowBox[{RowBox[{"{", RowBox[{"1", ",", " ", 
                       RowBox[{"kap", "[", "tn", "]"}]}], "}"}], " ", ".", 
                   " ", RowBox[{"Inverse", "[", RowBox[{"DiagonalMatrix", 
                       "[", RowBox[{"{", RowBox[{RowBox[{RowBox[{"-", "1"}], 
                          "/", "a"}], ",", " ", RowBox[{"Ks", "/", RowBox[
                          {"(", RowBox[{"a", " ", "dp", " ", "dm"}], 
                          ")"}]}]}], "}"}], "]"}], "]"}], " ", ".", " ", 
                   RowBox[{"{", RowBox[{"1", ",", " ", RowBox[{"kap", "[", 
                         "tmm", "]"}]}], "}"}]}]}], " ", "-", " ", RowBox[
                {"(", RowBox[{RowBox[{"4", " ", "a"}], " ", "-", " ", 
                   RowBox[{"4", " ", "a", " ", RowBox[{RowBox[{"PPt", "[", 
                         RowBox[{"-", "As"}], "]"}], "/", RowBox[{"(", 
                         RowBox[{"Ks", " ", RowBox[{"(", RowBox[{"tn", " ", 
                          "+", " ", "As"}], ")"}], " ", RowBox[{"(", RowBox[
                          {"tmm", " ", "+", " ", "As"}], ")"}]}], 
                         ")"}]}]}]}], ")"}]}], "]"}], " ", "===", " ", 
           "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"V_n = (2/beta) Theta^T (1, kappa_n)\"", "\[Rule]", 
      "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"Xi = diag(-1/a, K_s/(a d+ d-)) (A4)\"", "\[Rule]", 
      "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"d+ d- = P(-As)\"", "\[Rule]", "True"}]], "Output"], 
  Cell[BoxData[RowBox[{"\"Theorem singlet, separable part\"", "\[Rule]", 
      "True"}]], "Output"], Cell["5 The Cauchy matrix (mu != 0)", "Section"], 
  Cell["C_nm = rho/(z_n + z_m). Lemma \"square\", C^2 = h^2: for n != m, \
partial fractions reduce Sum_l C_nl C_lm to rho^2 [S(-z_n) - S(-z_m)]/(z_m - \
z_n), which vanishes because S is constant on the reflected lattice (Section \
3.1). For n = m the sum is rho^2 S'(-z_n) = h^2 (Section 3.1).", "Text"], 
  Cell[BoxData[RowBox[{"check", "[", RowBox[{"\"partial fractions for C^2\"", 
        ",", " ", RowBox[{RowBox[{"Simplify", "[", 
            RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[{"(", 
                      RowBox[{"zn", " ", "+", " ", "zl"}], ")"}], " ", 
                    RowBox[{"(", RowBox[{"zl", " ", "+", " ", "zm"}], 
                      ")"}]}], ")"}]}], " ", "-", " ", RowBox[{
                RowBox[{"(", RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[
                         {"zl", " ", "+", " ", "zn"}], ")"}]}], " ", "-", 
                    " ", RowBox[{"1", "/", RowBox[{"(", RowBox[{"zl", " ", 
                          "+", " ", "zm"}], ")"}]}]}], ")"}], "/", 
                RowBox[{"(", RowBox[{"zm", " ", "-", " ", "zn"}], ")"}]}]}], 
            "]"}], " ", "===", " ", "0"}]}], "]"}]], "Input"], 
  Cell[BoxData[RowBox[{"\"partial fractions for C^2\"", "\[Rule]", "True"}]], 
   "Output"], Cell["The thermal function alpha_k(x) := rho S_k(x) - cbar. \
Lemma \"thermal function\": its closed form and alpha_k(x) alpha_k(-x) = \
h^2.", "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{RowBox[{"alpha", "[", "par_", "]"}], "[", "x_", 
           "]"}], " ", ":=", " ", RowBox[
          {RowBox[{"rho", " ", RowBox[{RowBox[{"Sk", "[", "par", "]"}], "[", 
               "x", "]"}]}], " ", "-", " ", "cbar"}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"alpha closed form\"", ",", " ", 
         RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"FullSimplify", "[", 
                 RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[
                          {"alpha", "[", "par", "]"}], "[", "x", "]"}], " ", 
                         "+", " ", RowBox[{RowBox[{"Sqrt", "[", "hsq", "]"}], 
                          " ", RowBox[{RowBox[{RowBox[{"If", "[", RowBox[
                          {RowBox[{"par", " ", "==", " ", "0"}], ",", " ", 
                          "Cosh", ",", " ", "Sinh"}], "]"}], "[", RowBox[
                          {"beta", " ", RowBox[{RowBox[{"(", RowBox[{"x", 
                          " ", "+", " ", "mu"}], ")"}], "/", "2"}]}], "]"}], 
                          "/", RowBox[{RowBox[{"If", "[", RowBox[{RowBox[
                          {"par", " ", "==", " ", "0"}], ",", " ", "Cosh", 
                          ",", " ", "Sinh"}], "]"}], "[", RowBox[{"beta", 
                          " ", RowBox[{RowBox[{"(", RowBox[{"x", " ", "-", 
                          " ", "mu"}], ")"}], "/", "2"}]}], "]"}]}]}]}], 
                       ")"}], " ", "/.", " ", "thermal"}], ",", " ", 
                   RowBox[{RowBox[{"beta", " ", ">", " ", "0"}], " ", "&&", 
                     " ", RowBox[{"mu", " ", ">", " ", "0"}], " ", "&&", " ", 
                     RowBox[{"a", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", 
               RowBox[{"{", RowBox[{"par", ",", " ", RowBox[{"{", RowBox[
                      {"0", ",", " ", "1"}], "}"}]}], "}"}]}], "]"}], " ", 
           "===", " ", RowBox[{"{", RowBox[{"0", ",", " ", "0"}], "}"}]}]}], 
       "]"}], "\n", RowBox[{"check", "[", 
       RowBox[{"\"alpha(x) alpha(-x) = h^2\"", ",", " ", 
         RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"FullSimplify", "[", 
                 RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{RowBox[
                          {"alpha", "[", "par", "]"}], "[", "x", "]"}], " ", 
                         RowBox[{RowBox[{"alpha", "[", "par", "]"}], "[", 
                          RowBox[{"-", "x"}], "]"}]}], " ", "-", " ", 
                       "hsq"}], ")"}], " ", "/.", " ", "thermal"}], "]"}], 
               ",", " ", RowBox[{"{", RowBox[{"par", ",", " ", RowBox[
                    {"{", RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}]}], 
             "]"}], " ", "===", " ", RowBox[{"{", RowBox[{"0", ",", " ", 
               "0"}], "}"}]}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"alpha closed form\"", "\[Rule]", "True"}]], 
   "Output"], Cell[BoxData[RowBox[{"\"alpha(x) alpha(-x) = h^2\"", "\[Rule]", 
      "True"}]], "Output"], Cell["Lemma \"Cauchy calculus\": Sum_n rho/((z + \
z_n)(z_n - x)) = rho [S(x) - S(-z)]/(z + x) by partial fractions, and rho \
S(-z) = cbar on the lattice, so C maps 1/(t - x) to alpha_k(x)/(z + x), and \
the constant 1 to cbar (PV). Numerical test of the first rule (k = 2):", 
   "Text"], 
  Cell[BoxData[{RowBox[{"check", "[", RowBox[{"\"partial fractions for C\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[{RowBox[{"(", 
                       RowBox[{"z", " ", "+", " ", "zl"}], ")"}], " ", 
                     RowBox[{"(", RowBox[{"zl", " ", "-", " ", "x"}], 
                       ")"}]}], ")"}]}], " ", "-", " ", RowBox[
                {RowBox[{"(", RowBox[{RowBox[{"1", "/", RowBox[{"(", RowBox[
                          {"zl", " ", "-", " ", "x"}], ")"}]}], " ", "-", 
                     " ", RowBox[{"1", "/", RowBox[{"(", RowBox[{"zl", " ", 
                          "+", " ", "z"}], ")"}]}]}], ")"}], "/", 
                 RowBox[{"(", RowBox[{"z", " ", "+", " ", "x"}], ")"}]}]}], 
             "]"}], " ", "===", " ", "0"}]}], "]"}], "\n", 
     RowBox[{"Module", "[", RowBox[
        {RowBox[{"{", RowBox[{RowBox[{"k", " ", "=", " ", "2"}], ",", " ", 
             "nums", ",", " ", "zl", ",", " ", RowBox[{"x0", " ", "=", " ", 
               RowBox[{"0.4", " ", "+", " ", RowBox[{"0.3", " ", "I"}]}]}], 
             ",", " ", "zz"}], "}"}], ",", "\n", " ", 
         RowBox[{RowBox[{"nums", " ", "=", " ", RowBox[{"Join", "[", RowBox[
                {RowBox[{"{", RowBox[{RowBox[{"a", " ", "->", " ", "1"}], 
                     ",", " ", RowBox[{"beta", " ", "->", " ", "3"}], ",", 
                     " ", RowBox[{"mu", " ", "->", " ", RowBox[{"3", "/", 
                         "10"}]}]}], "}"}], ",", " ", RowBox[{"thermal", " ", 
                   "/.", " ", RowBox[{"{", RowBox[{RowBox[{"a", " ", "->", 
                         " ", "1"}], ",", " ", RowBox[{"beta", " ", "->", 
                         " ", "3"}], ",", " ", RowBox[{"mu", " ", "->", " ", 
                         RowBox[{"3", "/", "10"}]}]}], "}"}]}]}], "]"}]}], 
           ";", "\n", " ", RowBox[{RowBox[{"zl", "[", "n_", "]"}], " ", ":=", 
             " ", RowBox[{RowBox[{"(", RowBox[{"mu", " ", "+", " ", 
                   RowBox[{"I", " ", "Pi", " ", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"2", " ", "n"}], " ", "+", " ", "1", " ", 
                          "+", " ", "k"}], ")"}], "/", "beta"}]}]}], ")"}], 
               " ", "/.", " ", "nums"}]}], ";", " ", 
           RowBox[{"zz", " ", "=", " ", RowBox[{"zl", "[", "4", "]"}]}], ";", 
           "\n", " ", RowBox[{"check", "[", RowBox[
              {"\"C acting on 1/(t - x) vs direct sum\"", ",", " ", RowBox[
                {RowBox[{"Abs", "[", RowBox[{RowBox[{"N", "[", RowBox[
                        {"Sum", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                          {"rho", "/", RowBox[{"(", RowBox[{RowBox[{"(", 
                          RowBox[{"zz", " ", "+", " ", RowBox[{"zl", "[", 
                          "n", "]"}]}], ")"}], " ", RowBox[{"(", RowBox[
                          {RowBox[{"zl", "[", "n", "]"}], " ", "-", " ", 
                          "x0"}], ")"}]}], ")"}]}], ")"}], " ", "/.", " ", 
                          "nums"}], ",", " ", RowBox[{"{", RowBox[{"n", ",", 
                          " ", RowBox[{"-", "40000"}], ",", " ", "39999"}], 
                          "}"}]}], "]"}], "]"}], " ", "-", " ", RowBox[
                      {"N", "[", RowBox[{RowBox[{RowBox[{RowBox[{"alpha", 
                          "[", "0", "]"}], "[", "x0", "]"}], "/", RowBox[
                          {"(", RowBox[{"zz", " ", "+", " ", "x0"}], ")"}]}], 
                         " ", "/.", " ", "nums"}], "]"}]}], "]"}], " ", "<", 
                 " ", RowBox[{"10", "^", RowBox[{"-", "4"}]}]}]}], "]"}]}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"partial fractions for C\"", "\[Rule]", "True"}]], 
   "Output"], Cell[BoxData[RowBox[{"\"C acting on 1/(t - x) vs direct sum\"", 
      "\[Rule]", "True"}]], "Output"], Cell["6 Density and magnetic channels: \
the proof of Theorem \"density and magnetic\"", "Section"], 
  Cell["A case is {eps, st}: eps = +1 (d) or -1 (m), st = delta_(k0) (st = 1 \
means w = 0). All functions below are the ones extracted in Section 2.2. P(z) \
chi_r = -beta H(z) delta + lambda C + N(z, v)/P(v). The zeros of P and the \
values of S_k there (Section 3.1): four simple zeros for k != 0, two double \
zeros for k = 0.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"cases", " ", "=", " ", 
         RowBox[{"Tuples", "[", RowBox[{"{", RowBox[{RowBox[{"{", 
                 RowBox[{"1", ",", " ", RowBox[{"-", "1"}]}], "}"}], ",", 
               " ", RowBox[{"{", RowBox[{"0", ",", " ", "1"}], "}"}]}], 
             "}"}], "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"wr", "[", "st_", "]"}], " ", ":=", " ", 
         RowBox[{"If", "[", RowBox[{RowBox[{"st", " ", "==", " ", "1"}], ",", 
             " ", RowBox[{"{", RowBox[{"w", " ", "->", " ", "0"}], "}"}], 
             ",", " ", RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{RowBox[{"Hf", "[", RowBox[{"eps_", ",", " ", 
               "st_"}], "]"}], "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{"Hx", "[", "eps", "]"}], " ", "/.", " ", 
             RowBox[{"z", " ", "->", " ", "x"}]}], " ", "/.", " ", 
           RowBox[{"wr", "[", "st", "]"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{RowBox[{"Nf", "[", RowBox[{"eps_", ",", " ", 
               "st_"}], "]"}], "[", RowBox[{"x_", ",", " ", "y_"}], "]"}], 
         " ", ":=", " ", RowBox[{RowBox[{"NN", "[", RowBox[{"eps", ",", " ", 
               "st"}], "]"}], " ", "/.", " ", RowBox[
            {"{", RowBox[{RowBox[{"z", " ", "->", " ", "x"}], ",", " ", 
               RowBox[{"v", " ", "->", " ", "y"}]}], "}"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{RowBox[{"N2f", "[", RowBox[{"eps_", ",", " ", 
               "st_"}], "]"}], "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{"N2x", "[", RowBox[{"eps", ",", " ", "st"}], "]"}], 
           " ", "/.", " ", RowBox[{"v", " ", "->", " ", "x"}]}]}], ";"}], 
     "\n", RowBox[{RowBox[{RowBox[{RowBox[{"Pf", "[", "st_", "]"}], "[", 
           "x_", "]"}], " ", ":=", " ", RowBox[{RowBox[{"P", "[", "x", "]"}], 
           " ", "/.", " ", RowBox[{"wr", "[", "st", "]"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"lamf", "[", "eps_", "]"}], " ", ":=", " ", 
         RowBox[{"lam", "[", "eps", "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"pZeros", "[", "0", "]"}], " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[
                  {RowBox[{"-", "a"}], " ", "+", " ", RowBox[{"w", "/", 
                     "2"}]}], ",", " ", "1", ",", " ", "Splus"}], "}"}], ",", 
             " ", RowBox[{"{", RowBox[{RowBox[{RowBox[{"-", "a"}], " ", "-", 
                   " ", RowBox[{"w", "/", "2"}]}], ",", " ", "1", ",", " ", 
                 "Splus"}], "}"}], ",", " ", RowBox[{"{", RowBox[
                {RowBox[{"a", " ", "+", " ", RowBox[{"w", "/", "2"}]}], ",", 
                 " ", "1", ",", " ", "Sminus"}], "}"}], ",", " ", 
             RowBox[{"{", RowBox[{RowBox[{"a", " ", "-", " ", RowBox[
                    {"w", "/", "2"}]}], ",", " ", "1", ",", " ", "Sminus"}], 
               "}"}]}], "}"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"pZeros", "[", "1", "]"}], " ", "=", " ", 
         RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "a"}], ",", 
                 " ", "2", ",", " ", "Splus"}], "}"}], ",", " ", 
             RowBox[{"{", RowBox[{"a", ",", " ", "2", ",", " ", "Sminus"}], 
               "}"}]}], "}"}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"zeros of P\"", ",", " ", 
         RowBox[{"And", " ", "@@", " ", RowBox[{"Table", "[", 
             RowBox[{RowBox[{RowBox[{"Simplify", "[", RowBox[
                    {RowBox[{RowBox[{"Pf", "[", "st", "]"}], "[", "t", "]"}], 
                     " ", "-", " ", RowBox[{"Product", "[", RowBox[
                        {RowBox[{RowBox[{"(", RowBox[{"t", " ", "-", " ", 
                          RowBox[{"y", "[", RowBox[{"[", "1", "]"}], "]"}]}], 
                          ")"}], "^", RowBox[{"y", "[", RowBox[{"[", "2", 
                          "]"}], "]"}]}], ",", " ", RowBox[{"{", RowBox[
                          {"y", ",", " ", RowBox[{"pZeros", "[", "st", 
                          "]"}]}], "}"}]}], "]"}]}], "]"}], " ", "===", " ", 
                 "0"}], ",", " ", RowBox[{"{", RowBox[{"st", ",", " ", 
                   RowBox[{"{", RowBox[{"0", ",", " ", "1"}], "}"}]}], 
                 "}"}]}], "]"}]}]}], "]"}], "\n", 
     RowBox[{RowBox[{RowBox[{RowBox[{"ef", "[", RowBox[{"eps_", ",", " ", 
               "st_"}], "]"}], "[", "x_", "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{RowBox[{"Hf", "[", RowBox[{"eps", ",", " ", 
                   "st"}], "]"}], "[", "x", "]"}], " ", 
             RowBox[{RowBox[{"Hf", "[", RowBox[{"eps", ",", " ", "st"}], 
                 "]"}], "[", RowBox[{"-", "x"}], "]"}]}], " ", "-", " ", 
           RowBox[{RowBox[{RowBox[{"lamf", "[", "eps", "]"}], "^", "2"}], 
             " ", RowBox[{"hsq", "/", RowBox[{"beta", "^", "2"}]}]}]}]}], 
       ";"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"zeros of P\"", "\[Rule]", "True"}]], "Output"], 
  Cell["6.1 Lemma \"rank-two sums\"", "Subsection"], 
  Cell["I(z; x) = Sum_l N(z, z_l)/(P(z_l)(z_l - x)). By the residue rule its \
value is the residue at t = x, S(x) N(z, x)/P(x) = [cbar + alpha(x)] N(z, \
x)/(rho P(x)), plus the residues at the zeros of P. Ibar collects everything \
except the alpha term:", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{RowBox[{"Ibar", "[", RowBox[{"eps_", ",", " ", "st_"}], 
            "]"}], "[", RowBox[{"zz_", ",", " ", "x_"}], "]"}], " ", ":=", 
        " ", RowBox[{RowBox[{"cbar", " ", RowBox[
             {RowBox[{RowBox[{"Nf", "[", RowBox[{"eps", ",", " ", "st"}], 
                  "]"}], "[", RowBox[{"zz", ",", " ", "x"}], "]"}], "/", 
              RowBox[{"(", RowBox[{"rho", " ", RowBox[{RowBox[{"Pf", "[", 
                      "st", "]"}], "[", "x", "]"}]}], ")"}]}]}], " ", "+", 
          " ", RowBox[{"Sum", "[", RowBox[{RowBox[{"resS", "[", 
                RowBox[{RowBox[{RowBox[{RowBox[{"Nf", "[", RowBox[{"eps", 
                          ",", " ", "st"}], "]"}], "[", RowBox[{"zz", ",", 
                        " ", "t"}], "]"}], "/", RowBox[{"(", RowBox[
                       {RowBox[{RowBox[{"Pf", "[", "st", "]"}], "[", "t", 
                          "]"}], " ", RowBox[{"(", RowBox[{"t", " ", "-", 
                          " ", "x"}], ")"}]}], ")"}]}], ",", " ", "t", ",", 
                  " ", RowBox[{"y", "[", RowBox[{"[", "1", "]"}], "]"}], ",", 
                  " ", RowBox[{"y", "[", RowBox[{"[", "2", "]"}], "]"}], ",", 
                  " ", RowBox[{"y", "[", RowBox[{"[", "3", "]"}], "]"}]}], 
                "]"}], ",", " ", RowBox[{"{", RowBox[{"y", ",", " ", 
                  RowBox[{"pZeros", "[", "st", "]"}]}], "}"}]}], "]"}]}]}], 
      ";"}]], "Input"], Cell["6.2 Step 2: the constant (identity A6)", 
   "Subsection"], Cell["For y = 1: -beta H(z) + lambda cbar + PV Sum_l N(z, \
z_l)/P(z_l), the sum again by the residue rule. It equals beta N2(z)/(2 eps \
a), so the constant 2 eps a/beta^2 in the solution produces -N2(z)/beta.", 
   "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"constImage", "[", RowBox[{"eps_", ",", " ", 
             "st_"}], "]"}], " ", ":=", " ", 
         RowBox[{RowBox[{RowBox[{"-", "beta"}], " ", 
             RowBox[{RowBox[{"Hf", "[", RowBox[{"eps", ",", " ", "st"}], 
                 "]"}], "[", "z", "]"}]}], " ", "+", " ", 
           RowBox[{RowBox[{"lamf", "[", "eps", "]"}], " ", "cbar"}], " ", 
           "+", " ", RowBox[{"Sum", "[", RowBox[{RowBox[{"resS", "[", 
                 RowBox[{RowBox[{RowBox[{RowBox[{"Nf", "[", RowBox[{"eps", 
                          ",", " ", "st"}], "]"}], "[", RowBox[{"z", ",", 
                         " ", "t"}], "]"}], "/", RowBox[{RowBox[{"Pf", "[", 
                         "st", "]"}], "[", "t", "]"}]}], ",", " ", "t", ",", 
                   " ", RowBox[{"y", "[", RowBox[{"[", "1", "]"}], "]"}], 
                   ",", " ", RowBox[{"y", "[", RowBox[{"[", "2", "]"}], 
                     "]"}], ",", " ", RowBox[{"y", "[", RowBox[{"[", "3", 
                       "]"}], "]"}]}], "]"}], ",", " ", RowBox[
                {"{", RowBox[{"y", ",", " ", RowBox[{"pZeros", "[", "st", 
                     "]"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"Step 2 (A6)\"", ",", " ", 
         RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"Simplify", "[", 
                 RowBox[{RowBox[{"(", RowBox[{RowBox[{"constImage", " ", 
                         "@@", " ", "c"}], " ", "-", " ", RowBox[{"beta", 
                         " ", RowBox[{RowBox[{RowBox[{"N2f", "[", RowBox[
                          {"Sequence", " ", "@@", " ", "c"}], "]"}], "[", 
                          "z", "]"}], "/", RowBox[{"(", RowBox[{"2", " ", 
                          RowBox[{"c", "[", RowBox[{"[", "1", "]"}], "]"}], 
                          " ", "a"}], ")"}]}]}]}], ")"}], " ", "/.", " ", 
                   "norm"}], "]"}], " ", "===", " ", "0"}], ",", " ", 
             RowBox[{"{", RowBox[{"c", ",", " ", "cases"}], "}"}]}], "]"}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"Step 2 (A6)\"", "\[Rule]", "True"}]], "Output"], 
  Cell["6.3 Step 1: the Cauchy column (identity A7)", "Subsection"], 
  Cell["Try y = D delta_(z v) + E/(z + v). Its image under P(z) chi_r, term \
by term: -beta H(z) y(z); lambda C y = lambda D rho/(z + v) + lambda E \
(h^2/rho) delta_(z v) (by C^2 = h^2, since 1/(t + v) = C_(t v)/rho); and the \
rank-two sum D N(z, v)/P(v) + E I(z; -v) with alpha(-v) = 0 on the lattice \
(Section 3.1), so I(z; -v) = Ibar(z; -v). Split -beta H(z) E/(z + v) into its \
pole at z = -v and a polynomial. The coefficients of delta_(z v) and of 1/(z \
+ v) must be P(v) and 0:", "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"step1", "[", RowBox[{"eps_", ",", " ", "st_"}], 
           "]"}], " ", ":=", " ", RowBox[{RowBox[{"step1", "[", 
             RowBox[{"eps", ",", " ", "st"}], "]"}], " ", "=", " ", 
           RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                  {RowBox[{"H", " ", "=", " ", RowBox[{"Hf", "[", RowBox[
                        {"eps", ",", " ", "st"}], "]"}]}], ",", " ", 
                   RowBox[{"l", " ", "=", " ", RowBox[{"lamf", "[", "eps", 
                       "]"}]}], ",", " ", "sol", ",", " ", "Dv", ",", " ", 
                   "Ev", ",", " ", "rest"}], "}"}], ",", "\n", "   ", RowBox[
                {RowBox[{"sol", " ", "=", " ", RowBox[{"First", "[", 
                     RowBox[{"Solve", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{RowBox[{RowBox[{RowBox[{"-", "beta"}], 
                          " ", RowBox[{"H", "[", "v", "]"}], " ", "dv"}], 
                          " ", "+", " ", RowBox[{"l", " ", "hsq", " ", RowBox[
                          {"ev", "/", "rho"}]}]}], " ", "==", " ", RowBox[
                          {RowBox[{"Pf", "[", "st", "]"}], "[", "v", "]"}]}], 
                          ",", " ", RowBox[{RowBox[{RowBox[{"l", " ", "rho", 
                          " ", "dv"}], " ", "-", " ", RowBox[{"beta", " ", 
                          RowBox[{"H", "[", RowBox[{"-", "v"}], "]"}], " ", 
                          "ev"}]}], " ", "==", " ", "0"}]}], "}"}], ",", " ", 
                         RowBox[{"{", RowBox[{"dv", ",", " ", "ev"}], 
                          "}"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
                 RowBox[{RowBox[{"{", RowBox[{"Dv", ",", " ", "Ev"}], "}"}], 
                   " ", "=", " ", RowBox[{"Simplify", "[", RowBox[
                      {RowBox[{"{", RowBox[{"dv", ",", " ", "ev"}], "}"}], 
                       " ", "/.", " ", "sol"}], "]"}]}], ";", "\n", "   ", 
                 RowBox[{"rest", " ", "=", " ", RowBox[{RowBox[
                      {RowBox[{"-", "beta"}], " ", "Ev", " ", RowBox[
                        {"PolynomialQuotient", "[", RowBox[{RowBox[{"H", "[", 
                          "z", "]"}], ",", " ", RowBox[{"z", " ", "+", " ", 
                          "v"}], ",", " ", "z"}], "]"}]}], " ", "+", " ", 
                     RowBox[{"Dv", " ", RowBox[{RowBox[{RowBox[{"Nf", "[", 
                          RowBox[{"eps", ",", " ", "st"}], "]"}], "[", 
                          RowBox[{"z", ",", " ", "v"}], "]"}], "/", RowBox[
                          {RowBox[{"Pf", "[", "st", "]"}], "[", "v", 
                          "]"}]}]}], " ", "+", " ", RowBox[{"Ev", " ", 
                       RowBox[{RowBox[{"Ibar", "[", RowBox[{"eps", ",", " ", 
                          "st"}], "]"}], "[", RowBox[{"z", ",", " ", RowBox[
                          {"-", "v"}]}], "]"}]}]}]}], ";", "\n", "   ", 
                 RowBox[{"<|", RowBox[{RowBox[{"\"D\"", " ", "->", " ", 
                       "Dv"}], ",", " ", RowBox[{"\"E\"", " ", "->", " ", 
                       "Ev"}], ",", " ", RowBox[{"\"rest\"", " ", "->", " ", 
                       "rest"}]}], "|>"}]}]}], "]"}]}]}], ";"}], "\n", 
     RowBox[{"check", "[", RowBox[
        {"\"the pole part of -beta H(z) E/(z+v) is -beta H(-v) E/(z+v)\"", 
         ",", " ", RowBox[{RowBox[{"Simplify", "[", 
             RowBox[{RowBox[{"PolynomialRemainder", "[", RowBox[
                  {RowBox[{RowBox[{"Hf", "[", RowBox[{"1", ",", " ", "0"}], 
                       "]"}], "[", "z", "]"}], ",", " ", RowBox[{"z", " ", 
                     "+", " ", "v"}], ",", " ", "z"}], "]"}], " ", "-", " ", 
               RowBox[{RowBox[{"Hf", "[", RowBox[{"1", ",", " ", "0"}], 
                   "]"}], "[", RowBox[{"-", "v"}], "]"}]}], "]"}], " ", 
           "===", " ", "0"}]}], "]"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"D_v = -H(-v) P(v)/(beta e(v)), E_v = \
-lambda rho F(v)/beta^2, F = P/e\"", ",", " ", 
         RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[{"Simplify", "[", 
                 RowBox[{RowBox[{"(", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{RowBox[{"step1", "[", RowBox[{"Sequence", 
                          " ", "@@", " ", "c"}], "]"}], "[", "\"D\"", "]"}], 
                          ",", " ", RowBox[{RowBox[{"step1", "[", RowBox[
                          {"Sequence", " ", "@@", " ", "c"}], "]"}], "[", 
                          "\"E\"", "]"}]}], "}"}], " ", "-", " ", RowBox[
                        {"{", RowBox[{RowBox[{RowBox[{"-", RowBox[{RowBox[
                          {"Hf", "[", RowBox[{"Sequence", " ", "@@", " ", 
                          "c"}], "]"}], "[", RowBox[{"-", "v"}], "]"}]}], 
                          " ", RowBox[{RowBox[{RowBox[{"Pf", "[", RowBox[
                          {"c", "[", RowBox[{"[", "2", "]"}], "]"}], "]"}], 
                          "[", "v", "]"}], "/", RowBox[{"(", RowBox[{"beta", 
                          " ", RowBox[{RowBox[{"ef", "[", RowBox[{"Sequence", 
                          " ", "@@", " ", "c"}], "]"}], "[", "v", "]"}]}], 
                          ")"}]}]}], ",", " ", RowBox[{RowBox[{"-", RowBox[
                          {"lamf", "[", RowBox[{"c", "[", RowBox[{"[", "1", 
                          "]"}], "]"}], "]"}]}], " ", "rho", " ", RowBox[
                          {RowBox[{RowBox[{"Pf", "[", RowBox[{"c", "[", 
                          RowBox[{"[", "2", "]"}], "]"}], "]"}], "[", "v", 
                          "]"}], "/", RowBox[{"(", RowBox[{RowBox[{RowBox[
                          {"ef", "[", RowBox[{"Sequence", " ", "@@", " ", 
                          "c"}], "]"}], "[", "v", "]"}], " ", RowBox[{"beta", 
                          "^", "2"}]}], ")"}]}]}]}], "}"}]}], ")"}], " ", 
                   "/.", " ", RowBox[{"hsq", " ", "->", " ", RowBox[
                      {RowBox[{"beta", "^", "2"}], " ", "p0", " ", 
