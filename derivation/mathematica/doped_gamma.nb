                 "]"}], ";", " ", "poly"}]}], "]"}]}], ";"}], "\n", 
     RowBox[{"sTaylor", "[", RowBox[{"s0", ",", " ", "d", ",", " ", "3"}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"Riccati equation and oddness\"", "\[Rule]", 
