                   RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
       RowBox[{"(*", " ", RowBox[{RowBox[{"test", " ", "against", " ", 
             "direct", " ", "summation"}], ",", " ", 
           RowBox[{"k", " ", "even"}], ",", " ", RowBox[{"a", " ", "double", 
             " ", "and", " ", "a", " ", "simple", " ", "pole"}]}], " ", 
         "*)"}]}], "\n", RowBox[{"With", "[", 
       RowBox[{RowBox[{"{", RowBox[{RowBox[{"bt", " ", "=", " ", "2"}], ",", 
             " ", RowBox[{"m0", " ", "=", " ", RowBox[{"1", "/", "5"}]}], 
             ",", " ", RowBox[{"x0", " ", "=", " ", RowBox[
                {RowBox[{"3", "/", "10"}], " ", "+", " ", RowBox[
                  {RowBox[{"7", "/", "10"}], " ", "I"}]}]}], ",", " ", 
             RowBox[{"phi", " ", "=", " ", RowBox[{"1", "/", RowBox[
                  {"(", RowBox[{RowBox[{RowBox[{"(", RowBox[{"tt", " ", "-", 
                          " ", RowBox[{"3", "/", "10"}], " ", "-", " ", 
                          RowBox[{RowBox[{"7", "/", "10"}], " ", "I"}]}], 
                         ")"}], "^", "2"}], " ", RowBox[{"(", RowBox[
                        {"tt", " ", "+", " ", "1"}], ")"}]}], ")"}]}]}]}], 
           "}"}], ",", "\n", " ", RowBox[{"Module", "[", 
           RowBox[{RowBox[{"{", RowBox[{"z", " ", "=", " ", RowBox[
                  {RowBox[{"m0", " ", "+", " ", RowBox[{"I", " ", "Pi", " ", 
                       RowBox[{RowBox[{"(", RowBox[{RowBox[{"2", " ", "#"}], 
                          " ", "+", " ", "1"}], ")"}], "/", "bt"}]}]}], " ", 
                   "&"}]}], "}"}], ",", "\n", "  ", RowBox[{"check", "[", 
               RowBox[{"\"residue rule vs direct sum\"", ",", " ", 
                 RowBox[{RowBox[{"Abs", "[", RowBox[{RowBox[{"N", "[", 
                         RowBox[{RowBox[{"(", RowBox[{RowBox[{"resS", "[", 
                          RowBox[{"phi", ",", " ", "tt", ",", " ", "x0", ",", 
                          " ", "2", ",", " ", RowBox[{RowBox[{"Sk", "[", "0", 
