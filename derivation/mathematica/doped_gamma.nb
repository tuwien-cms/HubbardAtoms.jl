  Cell[BoxData[RowBox[{"\"all channels agree with finite boxes\"", "\[Rule]", 
      "True"}]], "Output"], 
  Cell["8 Half filling, the example of the note, and a genuine divergence", 
   "Section"], Cell["At mu = 0 the Cauchy entries rho/(z_n + z_m) become 0/0 \
on the mirror z_m = -z_n. The Lehmann expression of Section 1 is a divided \
difference of the entire function e^(beta s), continuous in its nodes, and \
the weights are continuous in mu, so chi at mu = 0 is the limit mu -> 0. On \
the mirror z + v = 2 mu, and lambda rho/(z + v) tends to lambda beta p0: C \
becomes beta p0 times the mirror.", "Text"], 
  Cell[BoxData[RowBox[{"check", "[", RowBox[{"\"rho/(2 mu) -> beta p0\"", 
        ",", " ", RowBox[{RowBox[{"Simplify", "[", 
            RowBox[{RowBox[{"Normal", "[", RowBox[{"Series", "[", 
                  RowBox[{RowBox[{RowBox[{"(", RowBox[{"rho", " ", "/.", " ", 
                          "thermal"}], ")"}], "/", RowBox[{"(", RowBox[
                         {"2", " ", "mu"}], ")"}]}], ",", " ", RowBox[
                     {"{", RowBox[{"mu", ",", " ", "0", ",", " ", "0"}], 
                      "}"}]}], "]"}], "]"}], " ", "-", " ", RowBox[{"(", 
                RowBox[{RowBox[{RowBox[{"beta", " ", "p0"}], " ", "/.", " ", 
                    "thermal"}], " ", "/.", " ", RowBox[{"mu", " ", "->", 
                    " ", "0"}]}], ")"}]}], "]"}], " ", "===", " ", "0"}]}], 
      "]"}]], "Input"], 
  Cell[BoxData[RowBox[{"\"rho/(2 mu) -> beta p0\"", "\[Rule]", "True"}]], 
   "Output"], Cell["Corollary \"half filling\" as stated in the note: h = \
beta p0, s^ = 4 eps a^2 (p0 - p1) - q0, g^(z) = 1/(z^2 - s^), D^ = beta - 2 \
eps a S_k(u^)/u^.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"closedHF", "[", RowBox[{"eps_", ",", " ", "k_", ",", 
            " ", "rules_"}], "]"}], " ", ":=", " ", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"st", " ", "=", " ", RowBox[
                   {"Boole", "[", RowBox[{"k", " ", "==", " ", "0"}], 
                    "]"}]}], ",", " ", RowBox[{"nr", " ", "=", " ", 
                  RowBox[{"numRules", "[", RowBox[{"k", ",", " ", RowBox[
                       {"Append", "[", RowBox[{"rules", ",", " ", RowBox[
                          {"mu", " ", "->", " ", "0"}]}], "]"}]}], "]"}]}], 
                ",", " ", "H", ",", " ", "Pz", ",", " ", "e", ",", " ", "l", 
                ",", " ", "sh", ",", " ", "uh", ",", " ", "Dh", ",", " ", 
                "bt", ",", " ", "aN", ",", " ", "p0N"}], "}"}], ",", "\n", 
            "  ", RowBox[{RowBox[{RowBox[{"{", RowBox[{"H", ",", " ", "Pz", 
                    ",", " ", "e"}], "}"}], " ", "=", " ", RowBox[
                 {RowBox[{"Function", "[", RowBox[{"f", ",", " ", RowBox[
                       {"Function", "[", RowBox[{"x", ",", " ", RowBox[
                          {"Evaluate", "[", RowBox[{"toNum", "[", RowBox[
                          {RowBox[{"f", "[", "x", "]"}], ",", " ", "nr"}], 
                          "]"}], "]"}]}], "]"}]}], "]"}], " ", "/@", " ", 
                  RowBox[{"{", RowBox[{RowBox[{"Hf", "[", RowBox[{"eps", ",", 
                          " ", "st"}], "]"}], ",", " ", RowBox[{"Pf", "[", 
                        "st", "]"}], ",", " ", RowBox[{"ef", "[", RowBox[
                         {"eps", ",", " ", "st"}], "]"}]}], "}"}]}]}], ";", 
              "\n", "  ", RowBox[{RowBox[{"{", RowBox[{"l", ",", " ", "bt", 
                    ",", " ", "aN", ",", " ", "p0N", ",", " ", "sh"}], "}"}], 
                " ", "=", " ", RowBox[{"toNum", "[", RowBox[
                   {RowBox[{"{", RowBox[{RowBox[{"lamf", "[", "eps", "]"}], 
                        ",", " ", "beta", ",", " ", "a", ",", " ", "p0", ",", 
                        " ", RowBox[{RowBox[{"4", " ", "eps", " ", RowBox[
                          {"a", "^", "2"}], " ", RowBox[{"(", RowBox[{"p0", 
                          " ", "-", " ", "p1"}], ")"}]}], " ", "-", " ", 
                          "q0"}]}], "}"}], ",", " ", "nr"}], "]"}]}], ";", 
              "\n", "  ", RowBox[{"uh", " ", "=", " ", RowBox[{"Sqrt", "[", 
                  "sh", "]"}]}], ";", " ", RowBox[{"Dh", " ", "=", " ", 
                RowBox[{"bt", " ", "-", " ", RowBox[{"2", " ", "eps", " ", 
                    "aN", " ", RowBox[{RowBox[{"toNum", "[", RowBox[
                         {RowBox[{RowBox[{"Sk", "[", RowBox[{"Mod", "[", 
                          RowBox[{"k", ",", " ", "2"}], "]"}], "]"}], "[", 
                          "uh", "]"}], ",", " ", "nr"}], "]"}], "/", 
                      "uh"}]}]}]}], ";", "\n", "  ", RowBox[{"Function", "[", 
                RowBox[{RowBox[{"{", RowBox[{"zn", ",", " ", "zm", ",", " ", 
                      "same", ",", " ", "mir"}], "}"}], ",", " ", 
                  RowBox[{RowBox[{"If", "[", RowBox[{"same", ",", " ", 
                        RowBox[{"bt", " ", RowBox[{"Pz", "[", "zn", "]"}], 
                          " ", RowBox[{"(", RowBox[{RowBox[{"1", "/", RowBox[
                          {"toNum", "[", RowBox[{RowBox[{"G2x", " ", "/.", 
                          " ", RowBox[{"z", " ", "->", " ", "zn"}]}], ",", 
                          " ", "nr"}], "]"}]}], " ", "-", " ", RowBox[
                          {RowBox[{"H", "[", "zn", "]"}], "/", RowBox[{"e", 
                          "[", "zn", "]"}]}]}], ")"}]}], ",", " ", "0"}], 
                      "]"}], " ", "+", " ", RowBox[{"2", " ", "eps", " ", 
                      "aN"}], "\n", "    ", "-", " ", RowBox[{"If", "[", 
                      RowBox[{"mir", ",", " ", RowBox[{"l", " ", "bt", " ", 
                          "p0N", " ", RowBox[{RowBox[{"Pz", "[", "zn", "]"}], 
                          "/", RowBox[{"e", "[", "zn", "]"}]}]}], ",", " ", 
                        "0"}], "]"}], " ", "-", " ", RowBox[{"2", " ", "eps", 
                      " ", "aN", " ", "bt", " ", RowBox[{RowBox[{RowBox[
                          {"Pz", "[", "uh", "]"}], "/", "Dh"}], "/", 
                        RowBox[{"(", RowBox[{RowBox[{"(", RowBox[{RowBox[
                          {"zn", "^", "2"}], " ", "-", " ", "sh"}], ")"}], 
                          " ", RowBox[{"(", RowBox[{RowBox[{"zm", "^", "2"}], 
                          " ", "-", " ", "sh"}], ")"}]}], ")"}]}]}]}]}], 
                "]"}]}]}], "]"}]}], ";"}]], "Input"], 
  Cell["Box at mu = 0: the form of Section 2.2 with C = beta p0 times the \
mirror, P(z) chi = -beta H(z) delta + lambda beta p0 delta_(m nbar) + N(z, \
v)/P(v), with H, lambda, N as extracted there.", "Text"], 
  Cell[BoxData[
    {RowBox[{RowBox[{RowBox[{"chiBoxHF", "[", RowBox[{"eps_", ",", " ", "k_", 
             ",", " ", "M_", ",", " ", "rules_"}], "]"}], " ", ":=", " ", 
         RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                {RowBox[{"idx", " ", "=", " ", RowBox[{"boxIdx", "[", 
                     RowBox[{"k", ",", " ", "M"}], "]"}]}], ",", " ", 
                 RowBox[{"st", " ", "=", " ", RowBox[{"Boole", "[", 
                     RowBox[{"k", " ", "==", " ", "0"}], "]"}]}], ",", " ", 
                 RowBox[{"nr", " ", "=", " ", RowBox[{"numRules", "[", 
                     RowBox[{"k", ",", " ", RowBox[{"Append", "[", RowBox[
                          {"rules", ",", " ", RowBox[{"mu", " ", "->", " ", 
                          "0"}]}], "]"}]}], "]"}]}], ",", " ", "bt", ",", 
                 " ", "zs", ",", " ", "X", ",", " ", "Y", ",", " ", "Pz", 
                 ",", " ", "mat", ",", " ", "n0"}], "}"}], ",", "\n", "  ", 
             RowBox[{RowBox[{"bt", " ", "=", " ", RowBox[{"beta", " ", "/.", 
                   " ", "nr"}]}], ";", " ", RowBox[{"zs", " ", "=", " ", 
                 RowBox[{"N", "[", RowBox[{"I", " ", "Pi", " ", RowBox[
                      {RowBox[{"(", RowBox[{RowBox[{"2", " ", "idx"}], " ", 
                          "+", " ", "1", " ", "+", " ", "k"}], ")"}], "/", 
                       "bt"}]}], "]"}]}], ";", " ", RowBox[{"n0", " ", "=", 
                 " ", RowBox[{"Length", "[", "idx", "]"}]}], ";", "\n", "  ", 
               RowBox[{"Pz", " ", "=", " ", RowBox[{RowBox[{"toNum", "[", 
                     RowBox[{RowBox[{RowBox[{"Pf", "[", "st", "]"}], "[", 
                         "z", "]"}], ",", " ", "nr"}], "]"}], " ", "/.", " ", 
                   RowBox[{"z", " ", "->", " ", "zs"}]}]}], ";", "\n", "  ", 
               RowBox[{RowBox[{"{", RowBox[{"X", ",", " ", "Y"}], "}"}], " ", 
                 "=", " ", RowBox[{"{", RowBox[{RowBox[{"Outer", "[", 
                       RowBox[{"Times", ",", " ", "zs", ",", " ", RowBox[
                          {"ConstantArray", "[", RowBox[{"1", ",", " ", 
                          "n0"}], "]"}]}], "]"}], ",", " ", RowBox[{"Outer", 
                       "[", RowBox[{"Times", ",", " ", RowBox[
                          {"ConstantArray", "[", RowBox[{"1", ",", " ", 
                          "n0"}], "]"}], ",", " ", "zs"}], "]"}]}], "}"}]}], 
               ";", "\n", "  ", RowBox[{"mat", " ", "=", " ", RowBox[
                  {RowBox[{RowBox[{"(", RowBox[{RowBox[{"toNum", "[", RowBox[
                          {RowBox[{"NN", "[", RowBox[{"eps", ",", " ", 
                          "st"}], "]"}], ",", " ", "nr"}], "]"}], " ", "/.", 
                         " ", RowBox[{"{", RowBox[{RowBox[{"z", " ", "->", 
                          " ", "X"}], ",", " ", RowBox[{"v", " ", "->", " ", 
                          "Y"}]}], "}"}]}], ")"}], "/", RowBox[{"Outer", "[", 
                       RowBox[{"Times", ",", " ", "Pz", ",", " ", "Pz"}], 
                       "]"}]}], " ", "+", " ", RowBox[{"DiagonalMatrix", "[", 
                     RowBox[{RowBox[{"-", "bt"}], " ", RowBox[{RowBox[
                          {"(", RowBox[{RowBox[{"toNum", "[", RowBox[
                          {RowBox[{RowBox[{"Hf", "[", RowBox[{"eps", ",", 
                          " ", "st"}], "]"}], "[", "z", "]"}], ",", " ", 
                          "nr"}], "]"}], " ", "/.", " ", RowBox[{"z", " ", 
                          "->", " ", "zs"}]}], ")"}], "/", "Pz"}]}], 
                     "]"}]}]}], ";", "\n", "  ", RowBox[{"mat", " ", "+=", 
                 " ", RowBox[{"SparseArray", "[", RowBox[{RowBox[{"Thread", 
                       "[", RowBox[{RowBox[{"Transpose", "[", RowBox[{"{", 
                          RowBox[{RowBox[{"Range", "[", "n0", "]"}], ",", 
                          " ", RowBox[{"Flatten", "[", RowBox[{RowBox[
