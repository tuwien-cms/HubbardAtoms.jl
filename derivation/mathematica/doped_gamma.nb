                         RowBox[{"{", RowBox[{"1", ",", " ", "0"}], "}"}], 
                         ",", " ", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], 
                          ",", " ", "2"}], "}"}]}], "]"}]}], ",", " ", 
                   RowBox[{"s", " ", "=", " ", RowBox[{"If", "[", RowBox[
                        {RowBox[{"r", " ", "===", " ", "\"t\""}], ",", " ", 
                         "1", ",", " ", RowBox[{"-", "1"}]}], "]"}]}]}], 
