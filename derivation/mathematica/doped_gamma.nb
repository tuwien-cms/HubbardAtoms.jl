                          "\"dk\"", "]"}], " ", "-", " ", RowBox[{"beta", 
                          " ", RowBox[{"gf", "[", "vn", "]"}], " ", RowBox[
                          {"gf", "[", "vm", "]"}]}]}]}], "}"}]}], "]"}], " ", 
                          "/.", " ", "mirror"}], ")"}], "/", "4"}]}], ",", 
                       "\n", "     ", RowBox[{"\"dd\"", " ", "->", " ", 
                         RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"toPP", 
                          "[", RowBox[{"c", " ", ".", " ", RowBox[{"{", 
                          RowBox[{RowBox[{"uu", "[", "\"dd\"", "]"}], ",", 
                          " ", RowBox[{"ud", "[", "\"dd\"", "]"}]}], "}"}]}], 
                          "]"}], " ", "/.", " ", RowBox[{"vm", " ", "->", 
                          " ", "vn"}]}], ")"}], "/", "4"}], " ", "+", " ", 
                          RowBox[{"s", " ", RowBox[{"Bpp", "/", 
                          "2"}]}]}]}]}], "|>"}]}], "]"}]}], "]"}]}]}], ";"}], 
     "\n", RowBox[{"check", "[", RowBox[{"\"chi_t has no generic part\"", 
         ",", " ", RowBox[{RowBox[{RowBox[{"chiPP", "[", "\"t\"", "]"}], "[", 
             "\"gen\"", "]"}], " ", "===", " ", "0"}]}], "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"chi_t has no generic part\"", "\[Rule]", "True"}]], 
   "Output"], Cell["Variables: b = 2 mu - wpp, x = mu + vn, t = x (b - x). \
The mirror x -> b - x leaves t invariant. Any function of vn that is \
invariant under the mirror is a function of t; toT finds it by inserting the \
root x = (b - sqrt(b^2 - 4t))/2.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"bb", " ", "=", " ", 
         RowBox[{RowBox[{"2", " ", "mu"}], " ", "-", " ", "wpp"}]}], ";"}], 
     "\n", RowBox[{RowBox[{RowBox[{"toT", "[", RowBox[{"f_", ",", " ", 
             "from_", ",", " ", "to_"}], "]"}], " ", ":=", " ", 
         RowBox[{"Factor", "[", RowBox[{"FullSimplify", "[", 
             RowBox[{"f", " ", "/.", " ", RowBox[{"from", " ", "->", " ", 
                 RowBox[{RowBox[{RowBox[{"(", RowBox[{"bb", " ", "-", " ", 
