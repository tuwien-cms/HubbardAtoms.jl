                          " ", "->", " ", "m0"}]}], "}"}]}], "]"}], " ", "-", 
                       " ", RowBox[{"N", "[", RowBox[{"Sum", "[", RowBox[
                          {RowBox[{"phi", " ", "/.", " ", RowBox[{"tt", " ", 
                          "->", " ", RowBox[{"z", "[", "n", "]"}]}]}], ",", 
                          " ", RowBox[{"{", RowBox[{"n", ",", " ", RowBox[
                          {"-", "40000"}], ",", " ", "39999"}], "}"}]}], 
                          "]"}], "]"}]}], "]"}], " ", "<", " ", RowBox[
                    {"10", "^", RowBox[{"-", "8"}]}]}]}], "]"}]}], "]"}]}], 
       "]"}]}], "Input"], 
  Cell[BoxData[RowBox[{"\"residue rule vs direct sum\"", "\[Rule]", 
      "True"}]], "Output"], Cell["3.1 Special values of S_k", "Subsection"], 
  Cell["Thermal weights p_i = e^(-beta E_i)/Z; only here are they needed \
explicitly. kk is an integer, k = 2 kk + par, and w = i omega_k = 2 pi i \
k/beta.", "Text"], 
  Cell[BoxData[{RowBox[{RowBox[{"Zsum", " ", "=", " ", 
         RowBox[{RowBox[{"Total", "[", RowBox[{RowBox[{"Exp", "[", 
                 RowBox[{RowBox[{"-", "beta"}], " ", "energy"}], "]"}], " ", 
               RowBox[{"{", RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", 
                   " ", "1"}], "}"}]}], "]"}], " ", "/.", " ", 
           RowBox[{"Thread", "[", RowBox[{"weight", " ", "->", " ", 
               "weight"}], "]"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"thermal", " ", "=", " ", RowBox[{"Thread", "[", 
           RowBox[{RowBox[{"{", RowBox[{"p0", ",", " ", "p1", ",", " ", 
                 "p2"}], "}"}], " ", "->", " ", RowBox[{"(", RowBox[
                {RowBox[{"Exp", "[", RowBox[{RowBox[{"-", "beta"}], " ", 
                     RowBox[{"{", RowBox[{RowBox[{"energy", "[", RowBox[
                          {"[", "1", "]"}], "]"}], ",", " ", RowBox[
                          {"energy", "[", RowBox[{"[", "2", "]"}], "]"}], 
                         ",", " ", RowBox[{"energy", "[", RowBox[{"[", "4", 
                          "]"}], "]"}]}], "}"}]}], "]"}], "/", RowBox[
                  {"Total", "[", RowBox[{"Exp", "[", RowBox[{RowBox[{"-", 
                         "beta"}], " ", "energy"}], "]"}], "]"}]}], ")"}]}], 
           "]"}]}], ";"}], "\n", 
     RowBox[{RowBox[{RowBox[{"wk", "[", "par_", "]"}], " ", ":=", " ", 
         RowBox[{"2", " ", "Pi", " ", "I", " ", 
           RowBox[{RowBox[{"(", RowBox[{RowBox[{"2", " ", "kk"}], " ", "+", 
                 " ", "par"}], ")"}], "/", "beta"}]}]}], ";"}], "\n", 
     RowBox[{RowBox[{"Splus", " ", "=", " ", RowBox[{"beta", " ", 
           RowBox[{RowBox[{"(", RowBox[{"p1", " ", "-", " ", "p0"}], ")"}], 
             "/", RowBox[{"(", RowBox[{"2", " ", RowBox[{"(", RowBox[
                    {"p1", " ", "+", " ", "p0"}], ")"}]}], ")"}]}]}]}], ";", 
       " ", RowBox[{"Sminus", " ", "=", " ", RowBox[{"beta", " ", 
           RowBox[{RowBox[{"(", RowBox[{"p2", " ", "-", " ", "p1"}], ")"}], 
             "/", RowBox[{"(", RowBox[{"2", " ", RowBox[{"(", RowBox[
                    {"p1", " ", "+", " ", "p2"}], ")"}]}], ")"}]}]}]}], 
       ";"}]}], "Input"], Cell["Eq. (shift): S_k(x +- w/2) = -beta/2 \
tanh(beta (x - mu)/2) for both parities. Hence S_k takes the value S_+ at \
both zeros -a +- w/2 of Q_+, and S_- at both zeros a +- w/2 of Q_-:", 
   "Text"], 
  Cell[BoxData[{RowBox[{"check", "[", RowBox[{"\"Eq. (shift)\"", ",", " ", 
         RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"FullSimplify", "[", 
                 RowBox[{RowBox[{RowBox[{RowBox[{"Sk", "[", "par", "]"}], 
                       "[", RowBox[{"x", " ", "+", " ", RowBox[{"s", " ", 
                          RowBox[{RowBox[{"wk", "[", "par", "]"}], "/", 
                          "2"}]}]}], "]"}], " ", "+", " ", RowBox[
                      {RowBox[{"beta", "/", "2"}], " ", RowBox[{"Tanh", "[", 
                         RowBox[{"beta", " ", RowBox[{RowBox[{"(", RowBox[
                          {"x", " ", "-", " ", "mu"}], ")"}], "/", "2"}]}], 
                         "]"}]}]}], ",", " ", RowBox[{"Element", "[", 
                     RowBox[{"kk", ",", " ", "Integers"}], "]"}]}], "]"}], 
               ",", " ", RowBox[{"{", RowBox[{"par", ",", " ", RowBox[
                    {"{", RowBox[{"0", ",", " ", "1"}], "}"}]}], "}"}], ",", 
               " ", RowBox[{"{", RowBox[{"s", ",", " ", RowBox[{"{", 
                     RowBox[{"1", ",", " ", RowBox[{"-", "1"}]}], "}"}]}], 
                 "}"}]}], "]"}], " ", "===", " ", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", " ", "0"}], 
                 "}"}], ",", " ", RowBox[{"{", RowBox[{"0", ",", " ", "0"}], 
                 "}"}]}], "}"}]}]}], "]"}], "\n", 
     RowBox[{"check", "[", RowBox[{"\"S_+ and S_- at the zeros of P\"", ",", 
         " ", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"FullSimplify", 
                 "[", RowBox[{RowBox[{RowBox[{"{", RowBox[{RowBox[
                          {RowBox[{RowBox[{"Sk", "[", "par", "]"}], "[", 
                          RowBox[{RowBox[{"-", "a"}], " ", "+", " ", RowBox[
                          {"s", " ", RowBox[{RowBox[{"wk", "[", "par", "]"}], 
                          "/", "2"}]}]}], "]"}], " ", "-", " ", "Splus"}], 
                         ",", " ", RowBox[{RowBox[{RowBox[{"Sk", "[", "par", 
                          "]"}], "[", RowBox[{"a", " ", "+", " ", RowBox[
                          {"s", " ", RowBox[{RowBox[{"wk", "[", "par", "]"}], 
                          "/", "2"}]}]}], "]"}], " ", "-", " ", "Sminus"}]}], 
                       "}"}], " ", "/.", " ", "thermal"}], ",", " ", 
                   RowBox[{RowBox[{"Element", "[", RowBox[{"kk", ",", " ", 
                         "Integers"}], "]"}], " ", "&&", " ", RowBox[
                      {"beta", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", 
               RowBox[{"{", RowBox[{"par", ",", " ", RowBox[{"{", RowBox[
                      {"0", ",", " ", "1"}], "}"}]}], "}"}], ",", " ", RowBox[
                {"{", RowBox[{"s", ",", " ", RowBox[{"{", RowBox[{"1", ",", 
